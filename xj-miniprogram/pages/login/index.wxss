/* ===== 登录页 ===== */
.page-login {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ===== 步骤一 ===== */
.step-welcome {
  padding: 0 64rpx;
  padding-top: calc(env(safe-area-inset-top) + 96rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 64rpx);
  justify-content: space-between;
}

/* ---- Brand 区域 ---- */
.brand-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

/* Logo 外层：固定尺寸，让 glow 和 card 都能绝对定位到这个盒子里 */
.logo-wrap {
  width: 192rpx;
  height: 192rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 红色模糊光晕 */
.logo-glow {
  position: absolute;
  inset: -40rpx;
  border-radius: 50%;
  background: rgba(236, 55, 19, 0.18);
  filter: blur(20rpx);
}

/* 白色圆角卡片 */
.logo-card {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  background: #fff;
  border: 2rpx solid #f3f4f6;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(3deg);
  box-shadow:
    0 40rpx 50rpx -10rpx rgba(0, 0, 0, 0.1),
    0 16rpx 20rpx -12rpx rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.logo-img {
  width: 112rpx;
  height: 112rpx;
}

/* App 名称 */
.app-name {
  font-size: 60rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: -1.5rpx;
  text-align: center;
}

/* 口号 */
.app-slogan {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.7rpx;
  text-align: center;
}

/* ---- 操作区 ---- */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* 微信登录按钮 */
.btn-wx-login {
  position: relative;
  width: 100%;
  height: 112rpx;
  background: var(--color-primary);
  border-radius: 24rpx;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 20rpx 30rpx -6rpx rgba(236, 55, 19, 0.3),
    0 8rpx 12rpx -8rpx rgba(236, 55, 19, 0.3);
}

.btn-wx-login::after {
  border: none;
}

/* 微信图标绝对定位在左侧 */
.btn-wx-icon {
  position: absolute;
  left: 48rpx;
  width: 48rpx;
  height: 48rpx;
}

.btn-wx-text {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: #fff;
  letter-spacing: 0.8rpx;
}

/* 手机号登录次级入口 */
.phone-login-link {
  display: flex;
  justify-content: center;
}

.phone-login-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ---- 协议区 ---- */
.agreement {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

/* 方形 checkbox：与第一行文字垂直居中对齐 */
.checkbox-square {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-top: 6rpx;          /* 对齐第一行文字中间 */
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-square.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-check {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

/* 协议文字容器：普通 block，不用 flex，保证 text 自然换行 */
.agreement-body {
  flex: 1;
}

/* 第一行："我已阅读并同意 《用户协议》 和 《隐私政策》" */
/* ⚠️ 注意：此 <text> 内部不能有换行，否则小程序会保留空白字符导致排版错乱 */
.agreement-line {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 40rpx;
}

.link {
  color: var(--color-primary);
  text-decoration: underline;
  text-decoration-color: rgba(236, 55, 19, 0.3);
}

/* 第二行说明文字 */
.agreement-hint {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  margin-top: 4rpx;
}

/* 底部淡色渐变装饰 */
.bottom-deco {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 384rpx;
  background: linear-gradient(to top, rgba(236, 55, 19, 0.04) 0%, transparent 100%);
  pointer-events: none;
}

/* ===== 步骤二/三：通用头部 ===== */
.step-header {
  padding: 80rpx 64rpx 60rpx;
  text-align: center;
}

.step-title {
  display: block;
  font-size: 44rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.step-desc {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.step-actions {
  margin-top: 60rpx;
  padding: 0 64rpx;
}

/* 通用主按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  border-radius: 24rpx;
  border: none;
  box-shadow:
    0 20rpx 30rpx -6rpx rgba(236, 55, 19, 0.3),
    0 8rpx 12rpx -8rpx rgba(236, 55, 19, 0.3);
}

.btn-primary::after {
  border: none;
}

/* ===== 步骤二：完善信息 ===== */
.profile-form {
  margin: 0 64rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: var(--shadow-card);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

.avatar-item {
  justify-content: space-between;
}

.avatar-btn {
  display: flex;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
}

.avatar-tip {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ===== 步骤三：绑定手机号 ===== */
.phone-form {
  margin-top: 20rpx;
  padding: 0 64rpx;
}

.btn-phone-wx {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  border-radius: 24rpx;
  border: none;
  margin-bottom: 40rpx;
}

.btn-phone-wx::after {
  border: none;
}

.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.phone-form .form-item {
  background: var(--color-bg-gray);
  border-radius: 16rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  border-bottom: none;
}

.phone-form .form-input {
  height: 96rpx;
}

.code-item {
  position: relative;
}

.btn-code {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: transparent;
  border: none;
}

.btn-code::after {
  border: none;
}

.btn-code.disabled {
  color: var(--color-text-tertiary);
}

.phone-form .btn-primary {
  margin-top: 40rpx;
}

.skip-area {
  margin-top: 40rpx;
  text-align: center;
}

.skip-btn {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  padding: 20rpx 40rpx;
}

/* ===== 底部说明 ===== */
.footer {
  padding: 40rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}
