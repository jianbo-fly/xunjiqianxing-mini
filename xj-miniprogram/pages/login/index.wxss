/* ===== 登录页 ===== */
.page-login {
  min-height: 100vh;
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ===== 步骤一 ===== */
.step-welcome {
  padding: 0 64rpx;
  padding-top: calc(env(safe-area-inset-top) + 96rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 64rpx);
  justify-content: space-between;
}

/* ---- Brand 区域 ---- */
.brand-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.logo-wrap {
  width: 192rpx;
  height: 192rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-glow {
  position: absolute;
  inset: -40rpx;
  border-radius: 50%;
  background: rgba(236, 55, 19, 0.18);
  filter: blur(20rpx);
}

.logo-card {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  background: #fff;
  border: 2rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(3deg);
  box-shadow:
    0 40rpx 50rpx -10rpx rgba(0, 0, 0, 0.1),
    0 16rpx 20rpx -12rpx rgba(0, 0, 0, 0.1);
  z-index: 1;
}

.logo-img {
  width: 112rpx;
  height: 112rpx;
}

.app-name {
  font-size: 60rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: -1.5rpx;
  text-align: center;
}

.app-slogan {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.7rpx;
  text-align: center;
}

/* ---- 操作区 ---- */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.btn-wx-login {
  position: relative;
  width: 100%;
  height: 112rpx;
  background: var(--color-primary);
  border-radius: var(--radius-md);
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 20rpx 30rpx -6rpx var(--color-primary-border),
    0 8rpx 12rpx -8rpx var(--color-primary-border);
}

.btn-wx-login::after {
  border: none;
}

.btn-wx-icon {
  position: absolute;
  left: 48rpx;
  width: 48rpx;
  height: 48rpx;
}

.btn-wx-text {
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-inverse);
  letter-spacing: 0.8rpx;
}

.phone-login-link {
  display: flex;
  justify-content: center;
}

.phone-login-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ---- 协议区 ---- */
.agreement {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox-square {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-top: 6rpx;
  border: 2rpx solid var(--color-border-medium);
  border-radius: var(--radius-xs);
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-square.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-check {
  font-size: 20rpx;
  color: var(--color-text-inverse);
  line-height: 1;
}

.agreement-body {
  flex: 1;
}

.agreement-line {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 40rpx;
}

.link {
  color: var(--color-primary);
  text-decoration: underline;
  text-decoration-color: var(--color-primary-border);
}

.agreement-hint {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  margin-top: 4rpx;
}

.bottom-deco {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 384rpx;
  background: linear-gradient(to top, rgba(236, 55, 19, 0.04) 0%, transparent 100%);
  pointer-events: none;
}

/* ===== 步骤二：绑定手机号（降级路径） ===== */
.step-header {
  padding: calc(env(safe-area-inset-top) + var(--spacing-xxl)) var(--spacing-xxl) var(--spacing-xl);
  text-align: center;
}

.step-title {
  display: block;
  font-size: 44rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.step-desc {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* 通用主按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 32rpx;
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-md);
  border: none;
  box-shadow:
    0 20rpx 30rpx -6rpx var(--color-primary-border),
    0 8rpx 12rpx -8rpx var(--color-primary-border);
}

.btn-primary::after {
  border: none;
}

.phone-form {
  margin-top: 20rpx;
  padding: 0 64rpx;
}

.form-item {
  display: flex;
  align-items: center;
  background: var(--color-bg-gray);
  border-radius: var(--radius-btn);
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
}

/* 输入框前置 icon */
.input-icon {
  width: var(--icon-size-sm);
  height: var(--icon-size-sm);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  opacity: 0.55;
}

.btn-code {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
  padding: 0 var(--spacing-md);
  height: 48rpx;
  line-height: 48rpx;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
  background: transparent;
  border: none;
  border-left: 2rpx solid var(--color-border-light);
  border-radius: 0;
  white-space: nowrap;
  transition: color var(--duration-fast);
}

.btn-code::after {
  border: none;
}

.btn-code.disabled {
  color: var(--color-text-disabled);
  font-variant-numeric: tabular-nums;
}

.phone-form .btn-primary {
  margin-top: 40rpx;
}

/* 必填说明 */
.phone-required-tip {
  margin-top: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-normal);
}

/* ===== 底部说明 ===== */
.footer {
  padding: 40rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}
