<!-- 登录页面 -->
<view class="page-login">
  <!-- 步骤一：欢迎页（一键登录 + 手机号授权） -->
  <view class="step step-welcome" wx:if="{{step === 1}}">

    <!-- Brand 区域：logo + 文字 -->
    <view class="brand-section">
      <view class="logo-wrap">
        <view class="logo-glow"></view>
        <view class="logo-card">
          <image class="logo-img" src="/assets/images/logo.png" mode="aspectFit" />
        </view>
      </view>
      <text class="app-name">寻迹千行</text>
      <text class="app-slogan">发现身边的美景 · 探索未知的世界</text>
    </view>

    <!-- 操作区 -->
    <view class="action-section">
      <!-- 微信一键登录 -->
      <button
        class="btn-wx-login"
        loading="{{logging}}"
        bindtap="handleWxLogin"
      >
        <image class="btn-wx-icon" src="/assets/icons/common/weixin.png" mode="aspectFit" />
        <text class="btn-wx-text">微信一键登录</text>
      </button>

      <!-- 手机号验证码登录 -->
      <view class="phone-login-link" bindtap="handlePhoneLogin">
        <text class="phone-login-text">手机号验证码登录</text>
      </view>

      <!-- 协议区 -->
      <view class="agreement" bindtap="handleAgreeChange">
        <view class="checkbox-square {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="checkbox-check">✓</text>
        </view>
        <view class="agreement-body">
          <text class="agreement-line">我已阅读并同意<text class="link" catchtap="handleViewAgreement">《用户协议》</text>和<text class="link" catchtap="handleViewPrivacy">《隐私政策》</text></text>
          <text class="agreement-hint">首次登录需绑定手机号以保障账号安全</text>
        </view>
      </view>
    </view>

    <view class="bottom-deco"></view>
  </view>

  <!-- 步骤二：绑定手机号（降级路径：拒绝一键授权 或 手机号验证码登录入口） -->
  <view class="step step-phone" wx:if="{{step === 2}}">
    <view class="step-header">
      <text class="step-title">绑定手机号</text>
      <text class="step-desc">绑定手机号，保障账号安全</text>
    </view>

    <view class="phone-form">
      <!-- 手动输入手机号 -->
      <view class="form-item">
        <image class="input-icon" src="/assets/icons/custom/phone.png" mode="aspectFit" />
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="handlePhoneInput"
        />
      </view>

      <!-- 验证码 -->
      <view class="form-item code-item">
        <image class="input-icon" src="/assets/icons/custom/lock.png" mode="aspectFit" />
        <input
          class="form-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          value="{{verifyCode}}"
          bindinput="handleCodeInput"
        />
        <button
          class="btn-code {{countdown > 0 ? 'disabled' : ''}}"
          disabled="{{countdown > 0}}"
          bindtap="handleSendCode"
        >
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>

      <button
        class="btn-primary"
        loading="{{submitting}}"
        bindtap="handleBindPhone"
      >
        {{fromPhoneEntry ? '登录' : '绑定手机号'}}
      </button>

      <!-- 说明 -->
      <view class="phone-required-tip">
        <text class="tip-text">为了保障账号安全，首次登录需绑定手机号</text>
      </view>
    </view>
  </view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">登录即表示您同意我们的服务条款</text>
  </view>
</view>
<xj-toast id="xj-toast"/>
