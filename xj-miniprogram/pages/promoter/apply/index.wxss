/**
 * 推广员申请页样式
 */

.page-promoter-apply {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== Hero ===== */
.apply-hero {
  position: relative;
  background: linear-gradient(150deg, #ec3713 0%, #ea580c 50%, #b91c1c 100%);
  overflow: hidden;
}

.hero-deco-tr {
  position: absolute;
  top: -128rpx;
  right: -128rpx;
  width: 512rpx;
  height: 512rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(20px);
}

.hero-deco-bl {
  position: absolute;
  bottom: -80rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(250, 204, 21, 0.2);
  border-radius: 50%;
  filter: blur(12px);
}

/* Nav row */
.hero-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  position: relative;
  z-index: 1;
}

.hero-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.hero-back-icon {
  width: 24rpx;
  height: 40rpx;
}

.hero-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-text-inverse);
}

.hero-placeholder {
  width: 64rpx;
}

/* Hero content */
.hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 96rpx;
  position: relative;
  z-index: 1;
}

.hero-icon-bg {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  backdrop-filter: blur(4px);
}

.hero-icon {
  width: 56rpx;
  height: 56rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ===== Benefits card ===== */
.benefits-card {
  margin: -48rpx 40rpx 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 40rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 1;
}

.benefits-label {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
}

.benefits-grid {
  display: flex;
  justify-content: space-around;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.benefit-icon-bg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

/* 专属海报 — 红色渐变 */
.benefit-icon-bg--red {
  background: linear-gradient(135deg, #fff0ed 0%, #ffd6cc 100%);
  border: 2rpx solid rgba(236, 55, 19, 0.18);
  box-shadow: var(--shadow-primary-sm);
}

/* 积分奖励 — 橙黄渐变 */
.benefit-icon-bg--orange {
  background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
  border: 2rpx solid rgba(249, 115, 22, 0.18);
  box-shadow: var(--shadow-primary-sm);
}

/* 数据看板 — 蓝色渐变 */
.benefit-icon-bg--blue {
  background: linear-gradient(135deg, #eff6ff 0%, #bfdbfe 100%);
  border: 2rpx solid rgba(59, 130, 246, 0.18);
  box-shadow: var(--shadow-sm);
}

.benefit-icon {
  width: 40rpx;
  height: 40rpx;
}

.benefit-name {
  font-size: 24rpx;
  color: var(--color-text-body);
  margin-bottom: 4rpx;
}

.benefit-sub {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* ===== Form ===== */
.form-section {
  margin: 48rpx 40rpx 0;
}

.form-section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.form-card {
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 34rpx;
  box-shadow: var(--shadow-sm);
}

.form-card--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-btn {
  width: 100%;
  box-sizing: border-box;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 34rpx;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}

.avatar-btn::after {
  border: none;
}

.form-card--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--color-text-body);
}

.avatar-wrap {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(236, 55, 19, 0.2);
  padding: 8rpx;
  box-sizing: border-box;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-edit-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
}

.input-bg {
  position: relative;
  background: var(--color-bg-page);
  border-radius: var(--radius-btn);
  padding: 24rpx 80rpx 24rpx 32rpx;
}

.input-edit-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  color: var(--color-text-primary);
}

.form-hint-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hint-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.form-hint {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ===== Cert card ===== */
.cert-card {
  display: flex;
  gap: 32rpx;
  align-items: flex-start;
  margin: 24rpx 40rpx 0;
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-tint);
  border-radius: var(--radius-md);
  padding: 34rpx;
}

.cert-bg-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.cert-info {
  flex: 1;
}

.cert-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.cert-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== Fixed footer ===== */
.apply-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  border-top: 2rpx solid var(--color-border-light);
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-inset-top);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: center;
}

.agree-box {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-border-medium);
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.agree-box--checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.agree-check {
  font-size: 26rpx;
  color: var(--color-text-inverse);
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.agree-link {
  color: var(--color-primary);
  font-weight: 500;
}

.submit-btn {
  background: var(--color-primary);
  border-radius: var(--radius-md);
  padding: 32rpx;
  text-align: center;
  box-shadow: var(--shadow-primary-lg);
}

.submit-btn--disabled {
  opacity: 0.6;
}

.submit-text {
  font-size: 32rpx;
  color: var(--color-text-inverse);
  font-weight: 500;
}
