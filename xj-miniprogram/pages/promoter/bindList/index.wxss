/**
 * 推广明细页样式
 */

.page-bind-list {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ===== Summary header ===== */
.summary-header {
  position: relative;
  background: linear-gradient(150deg, #ec3713 0%, #ea580c 50%, #b91c1c 100%);
  overflow: hidden;
  padding-bottom: 48rpx;
}

.hero-deco-tr {
  position: absolute;
  top: -128rpx;
  right: -128rpx;
  width: 512rpx;
  height: 512rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  filter: blur(20px);
}

.header-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  position: relative;
  z-index: 1;
}

.header-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.header-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.9);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.header-nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #fff;
}

.summary-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 40rpx 0;
  position: relative;
  z-index: 1;
}

.summary-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-stat-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.summary-stat-value--points {
  color: #fde68a;
}

.summary-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.summary-stat-divider {
  width: 2rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ===== Tab bar ===== */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #f3f4f6;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 0;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: #9ca3af;
  padding-bottom: 24rpx;
}

.tab-item--active .tab-text {
  color: #ec3713;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ec3713;
  border-radius: 3rpx;
}

/* ===== Tab content ===== */
.tab-content {
  padding-top: 8rpx;
}

/* Filter row */
.filter-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 40rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #6b7280;
}

.filter-arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #9ca3af;
  border-bottom: 3rpx solid #9ca3af;
  transform: rotate(45deg);
  margin-top: -4rpx;
}

/* ===== Timeline (Scan records) ===== */
.timeline-list {
  padding: 0 40rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.timeline-dot-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  flex-shrink: 0;
  padding-top: 32rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d1d5db;
  flex-shrink: 0;
}

.timeline-dot--first {
  background: #ec3713;
}

.timeline-line {
  flex: 1;
  width: 4rpx;
  background: #e5e7eb;
  margin-top: 8rpx;
  min-height: 40rpx;
}

.timeline-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.scan-user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.scan-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.scan-user-info {
  flex: 1;
}

.scan-user-phone {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.scan-user-id {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.scan-time {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

/* ===== Order cards ===== */
.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 40rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-card-top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.order-product-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.order-main-info {
  flex: 1;
}

.order-product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.order-buyer-phone {
  font-size: 24rpx;
  color: #6b7280;
}

.order-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 2rpx solid #f9fafb;
}

.order-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-date {
  font-size: 22rpx;
  color: #9ca3af;
}

.order-no {
  font-size: 20rpx;
  color: #d1d5db;
}

.order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.order-points-badge {
  background: rgba(236, 55, 19, 0.08);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.order-points-text {
  font-size: 22rpx;
  color: #ec3713;
  font-weight: 500;
}

/* ===== Common ===== */
.empty-block {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.list-loading {
  display: flex;
  justify-content: center;
  padding: 48rpx 0;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #ec3713;
}
