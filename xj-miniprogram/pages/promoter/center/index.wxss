/**
 * 推广中心页样式
 */

.page-promoter-center {
  min-height: 100vh;
  background: #f8f6f6;
}

/* ===== Header (nav only, short) ===== */
.center-header {
  position: relative;
  background: #ec3713;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  box-shadow: 0 20rpx 30rpx -6rpx rgba(0, 0, 0, 0.1);
  padding-bottom: 160rpx;
}

.hero-deco-tr {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 256rpx;
  height: 256rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(20px);
}

.hero-deco-bl {
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 192rpx;
  height: 192rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  filter: blur(12px);
}

/* Nav */
.hero-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  position: relative;
  z-index: 1;
}

.hero-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.hero-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.9);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.9);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.hero-nav-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  letter-spacing: 1rpx;
}

.hero-nav-right {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.hero-settings-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ===== Main content (overlaps header) ===== */
.main-content {
  margin-top: -140rpx;
  padding: 0 40rpx 80rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* ===== Profile card ===== */
.profile-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 42rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  border: 2rpx solid #fdf3f1;
  box-shadow: 0 8rpx 40rpx -4rpx rgba(236, 55, 19, 0.1);
}

.profile-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar-ring {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 8rpx;
  background: linear-gradient(45deg, #ec3713 0%, #fdba74 100%);
}

.profile-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-sizing: border-box;
}

.level-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  background: #ec3713;
  border: 4rpx solid #fff;
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
}

.level-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.status-badge {
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
}

.status-badge--active {
  background: #dcfce7;
}

.status-badge--pending {
  background: #fef9c3;
}

.status-badge-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #15803d;
}

.status-badge--pending .status-badge-text {
  color: #a16207;
}

.profile-id {
  font-size: 26rpx;
  color: #8a5e55;
}

/* ===== Stat cards ===== */
.stat-cards {
  display: flex;
  gap: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 34rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #fdf3f1;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.stat-card--highlight {
  position: relative;
  overflow: hidden;
}

.stat-card--highlight::after {
  content: '';
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(236, 55, 19, 0.1);
  border-bottom-left-radius: 24rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.stat-value--highlight {
  color: #ec3713;
}

.stat-label {
  font-size: 24rpx;
  color: #8a5e55;
  margin-top: 8rpx;
}

/* ===== Poster section ===== */
.poster-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 42rpx;
  border: 2rpx solid #fdf3f1;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.poster-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.poster-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.poster-title-icon {
  width: 36rpx;
  height: 36rpx;
}

.poster-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.poster-style-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.poster-style-text {
  font-size: 24rpx;
  color: #ec3713;
}

.poster-style-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #ec3713;
  border-top: 3rpx solid #ec3713;
  transform: rotate(45deg);
}

/* Poster visual */
.poster-visual {
  position: relative;
  height: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx -8rpx rgba(236, 55, 19, 0.45);
  /* 品牌渐变背景 */
  background: linear-gradient(160deg, #ff6b3d 0%, #ec3713 40%, #c0291a 75%, #8b1710 100%);
}

/* 装饰大圆 — 右上 */
.poster-visual::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
}

/* 装饰大圆 — 左下 */
.poster-visual::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -80rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, transparent 70%);
}

.poster-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* 底部加深，提升 QR 卡可读性 */
.poster-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.55) 0%,
    rgba(0, 0, 0, 0.1) 45%,
    transparent 100%
  );
}

/* 右侧竖向装饰文字 */
.poster-deco-text {
  position: absolute;
  bottom: 40rpx;
  right: 32rpx;
  transform: rotate(90deg);
  transform-origin: right bottom;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.15);
  letter-spacing: 6rpx;
  white-space: nowrap;
}

.poster-brand {
  position: absolute;
  top: 32rpx;
  left: 40rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.poster-brand-logo-wrap {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  backdrop-filter: blur(4px);
}

.poster-brand-logo-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: -1rpx;
}

.poster-brand-text-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.poster-brand-cn {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.poster-brand-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
}

/* 二维码居中区 */
.poster-qr-center {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 120rpx; /* 品牌区高度 */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

/* 二维码白色方框 */
.poster-qr-wrap {
  width: 240rpx;
  height: 240rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 14rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 20rpx;
}

.poster-qr-img {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.poster-qr-placeholder {
  width: 100%;
  height: 100%;
  background: #fdf3f1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-qr-placeholder-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.poster-qr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.poster-qr-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.poster-qr-code-chip {
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  backdrop-filter: blur(4px);
}

.poster-qr-code-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

/* Poster actions */
.poster-actions {
  display: flex;
  gap: 24rpx;
}

.poster-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 26rpx;
  border: 2rpx solid #fcebe8;
  border-radius: 24rpx;
}

.poster-btn--primary {
  background: #ec3713;
  border-color: #ec3713;
  box-shadow: 0 20rpx 30rpx -6rpx rgba(236, 55, 19, 0.3);
}

.poster-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.poster-btn-icon--white {
  /* tint handled by icon color */
}

.poster-btn-text {
  font-size: 28rpx;
  color: #404040;
}

.poster-btn-text--primary {
  color: #fff;
}

/* ===== Utility links ===== */
.util-section {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #fdf3f1;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  padding: 0 32rpx;
}

.util-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 0;
}

.util-divider {
  height: 2rpx;
  background: #fdf3f1;
}

.util-icon-bg {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.util-icon-bg--edit {
  background: #eff6ff;
}

.util-icon-bg--detail {
  background: #fff7ed;
}

.util-icon {
  width: 36rpx;
  height: 36rpx;
}

.util-label {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
}

.util-arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* ===== Footer ===== */
.footer-quote {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.footer-quote-text {
  font-size: 24rpx;
  color: #a3a3a3;
}

/* ===== Loading ===== */
.loading-block {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
