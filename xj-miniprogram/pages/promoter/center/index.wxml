<!--
  推广中心页
-->
<view class="page-promoter-center">

  <!-- Short red header (nav only) -->
  <view class="center-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero-deco-tr"></view>
    <view class="hero-deco-bl"></view>
    <view class="hero-nav" style="height: {{navBarHeight}}px;">
      <view class="hero-back-btn" bindtap="handleBack">
        <view class="hero-back-icon"></view>
      </view>
      <text class="hero-nav-title">推广中心</text>
      <view class="hero-nav-right" bindtap="handleEditProfile">
        <image class="hero-settings-icon" src="/assets/icons/member/settings.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Main content overlaps header -->
  <view class="main-content">

    <!-- Profile card (floating white card) -->
    <view class="profile-card" wx:if="{{!loading}}">
      <view class="profile-avatar-wrap">
        <view class="avatar-ring">
          <image
            class="profile-avatar"
            src="{{promoter.avatar || '/assets/images/placeholder/avatar.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="level-badge">
          <text class="level-badge-text">V{{promoter.level || 1}}</text>
        </view>
      </view>
      <view class="profile-info">
        <view class="profile-name-row">
          <text class="profile-name">{{promoter.nickname || promoter.name || '推广员'}}</text>
          <view class="status-badge status-badge--active" wx:if="{{promoter.status === 1}}">
            <text class="status-badge-text">活跃推广员</text>
          </view>
          <view class="status-badge status-badge--pending" wx:elif="{{promoter.status === 0}}">
            <text class="status-badge-text">审核中</text>
          </view>
        </view>
        <text class="profile-id">推广 ID: {{promoter.promoterId || promoter.promoCode || '—'}}</text>
      </view>
    </view>

    <!-- 3 Stat cards -->
    <view class="stat-cards" wx:if="{{!loading}}">
      <view class="stat-card">
        <text class="stat-value">{{promoter.scanCount || 0}}</text>
        <text class="stat-label">累计扫码</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{promoter.orderCount || 0}}</text>
        <text class="stat-label">推广订单</text>
      </view>
      <view class="stat-card stat-card--highlight">
        <text class="stat-value stat-value--highlight">{{promoter.points || 0}}</text>
        <text class="stat-label">我的积分</text>
      </view>
    </view>

    <!-- Poster section -->
    <view class="poster-section" wx:if="{{!loading}}">
      <view class="poster-section-header">
        <view class="poster-title-row">
          <image class="poster-title-icon" src="/assets/icons/promoter/qrcode-title.png" mode="aspectFit" />
          <text class="poster-title">我的推广码</text>
        </view>
        <view class="poster-style-btn">
          <text class="poster-style-text">更换样式</text>
          <view class="poster-style-arrow"></view>
        </view>
      </view>

      <!-- Poster visual -->
      <view class="poster-visual">
        <view class="poster-gradient"></view>
        <text class="poster-deco-text">TRAVEL · SHARE · EARN</text>

        <!-- 品牌区（顶部横排） -->
        <view class="poster-brand">
          <view class="poster-brand-logo-wrap">
            <text class="poster-brand-logo-text">寻</text>
          </view>
          <view class="poster-brand-text-col">
            <text class="poster-brand-cn">寻迹千行</text>
            <text class="poster-brand-sub">探索未知，从这里开始</text>
          </view>
        </view>

        <!-- 二维码居中区 -->
        <view class="poster-qr-center">
          <view class="poster-qr-wrap">
            <image
              wx:if="{{promoter.qrCodeUrl}}"
              class="poster-qr-img"
              src="{{promoter.qrCodeUrl}}"
              mode="aspectFit"
              show-menu-by-longpress
            />
            <view class="poster-qr-placeholder" wx:else>
              <image class="poster-qr-placeholder-icon" src="/assets/icons/promoter/benefit-points.png" mode="aspectFit" />
            </view>
          </view>
          <text class="poster-qr-name">{{promoter.nickname || promoter.name || '推广员'}}</text>
          <text class="poster-qr-hint">长按识别小程序码</text>
          <view class="poster-qr-code-chip" wx:if="{{promoter.promoCode}}">
            <text class="poster-qr-code-label">推广码 · {{promoter.promoCode}}</text>
          </view>
        </view>
      </view>

      <!-- Action buttons -->
      <view class="poster-actions">
        <view class="poster-btn" bindtap="handleSaveImage">
          <image class="poster-btn-icon" src="/assets/icons/promoter/btn-save.png" mode="aspectFit" />
          <text class="poster-btn-text">保存图片</text>
        </view>
        <view class="poster-btn poster-btn--primary" bindtap="handleShare">
          <image class="poster-btn-icon" src="/assets/icons/promoter/btn-share.png" mode="aspectFit" />
          <text class="poster-btn-text poster-btn-text--primary">立即分享</text>
        </view>
      </view>
    </view>

    <!-- Utility links -->
    <view class="util-section" wx:if="{{!loading}}">
      <view class="util-item" bindtap="handleEditProfile">
        <view class="util-icon-bg util-icon-bg--edit">
          <image class="util-icon" src="/assets/icons/promoter/menu-edit.png" mode="aspectFit" />
        </view>
        <text class="util-label">修改资料</text>
        <image class="util-arrow-icon" src="/assets/icons/promoter/menu-chevron.png" mode="aspectFit" />
      </view>
      <view class="util-divider"></view>
      <view class="util-item" bindtap="handlePromoterDetail">
        <view class="util-icon-bg util-icon-bg--detail">
          <image class="util-icon" src="/assets/icons/promoter/menu-detail.png" mode="aspectFit" />
        </view>
        <text class="util-label">推广明细</text>
        <image class="util-arrow-icon" src="/assets/icons/promoter/menu-chevron.png" mode="aspectFit" />
      </view>
    </view>

    <!-- Footer -->
    <view class="footer-quote" wx:if="{{!loading}}">
      <text class="footer-quote-text">让每一次旅行都值得铭记</text>
    </view>

    <!-- Loading -->
    <view class="loading-block" wx:if="{{loading}}">
      <xj-loading text="加载中..." vertical />
    </view>

  </view>

</view>
<xj-toast id="xj-toast"/>
