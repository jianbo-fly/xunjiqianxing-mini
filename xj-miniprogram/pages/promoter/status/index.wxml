<!-- 推广员审核状态页 -->
<nav-bar title="推广员审核" show-back="{{true}}" fixed="{{true}}" background="#fff" />

<view class="page-status">
  <!-- 主内容区 -->
  <view class="status-content">
    <!-- 沙漏图标区 -->
    <view class="icon-section">
      <view class="icon-circle-outer">
        <view class="icon-circle-inner">
          <image class="icon-hourglass" src="/assets/icons/promoter/hourglass.png" mode="aspectFit" />
        </view>
        <view class="icon-badge">PENDING</view>
      </view>
    </view>

    <!-- 状态标题 -->
    <text class="status-title">审核中</text>

    <!-- 描述文字 -->
    <view class="status-desc">
      <text class="status-desc-text">您的申请正在加急处理中，请耐心等待。</text>
      <view class="status-desc-timeline">
        <text class="status-desc-text">预计 </text>
        <text class="status-desc-highlight">1-3 个工作日</text>
        <text class="status-desc-text"> 内出结果。</text>
      </view>
    </view>

    <!-- 提交信息卡片 -->
    <view class="detail-card">
      <view class="detail-header">
        <text class="detail-header-label">提交信息</text>
        <image class="detail-header-icon" src="/assets/icons/member/about.png" mode="aspectFit" />
      </view>

      <view class="detail-row">
        <text class="detail-label">提交人</text>
        <text class="detail-value">{{promoter.nickname || '--'}}</text>
      </view>

      <view class="detail-row">
        <text class="detail-label">提交时间</text>
        <text class="detail-value">{{promoter.applyTime || '--'}}</text>
      </view>

      <view class="detail-row detail-row--last">
        <text class="detail-label">申请类型</text>
        <view class="detail-tag">{{promoter.type || '推广员'}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="footer-actions">
    <button class="btn-contact" bindtap="handleContact">
      <image class="btn-contact-icon" src="/assets/icons/common/service.png" mode="aspectFit" />
      <text>联系客服</text>
    </button>
    <text class="footer-hint">如有疑问，请点击上方按钮咨询人工客服</text>
  </view>
</view>
