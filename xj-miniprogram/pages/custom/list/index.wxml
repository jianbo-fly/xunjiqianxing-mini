<!--
  我的定制列表
  对齐 Figma Node: 76-9523
-->
<view class="page-cl">

  <!-- 导航栏 -->
  <nav-bar title="我的定制" background="rgba(248,246,246,0.9)" showBack fixed blur />

  <!-- Tabs 导航栏 -->
  <view class="cl-tabs" style="top: {{navBarTotalHeight}}px;">
    <view
      class="cl-tab {{currentTab === index ? 'cl-tab--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="handleTabChange"
    >
      <text class="cl-tab__text">{{item}}</text>
      <view class="cl-tab__line" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- 列表内容 -->
  <view class="cl-main">

    <!-- 卡片列表 -->
    <view class="cl-list" wx:if="{{list.length}}">
      <view
        class="cl-card {{item.statusClass === 'following' ? 'cl-card--following' : ''}}"
        wx:for="{{list}}"
        wx:key="id"
        bindtap="handleCardTap"
        data-id="{{item.id}}"
      >
        <!-- 跟进中卡片右上角装饰 -->
        <view class="cl-card__deco" wx:if="{{item.statusClass === 'following'}}"></view>

        <!-- 头部：图标 + 标题/编号 + 状态徽章 -->
        <view class="cl-card__header">
          <view class="cl-card__icon-wrap" style="background: {{item.iconBg}};">
            <image class="cl-card__icon" src="{{item.iconPath}}" mode="aspectFit" />
          </view>
          <view class="cl-card__title-wrap">
            <text class="cl-card__title">{{item.destination}}</text>
            <text class="cl-card__no">定制编号: {{item.orderNo}}</text>
          </view>
          <view class="cl-badge cl-badge--{{item.statusClass}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>

        <!-- 信息 2×2 格（出发日期 | 天数 | 人数 | 价格） -->
        <view class="cl-info-grid">
          <view class="cl-info-item">
            <image class="cl-info-icon" src="/assets/icons/custom-list/cl-calendar.png" mode="aspectFit" />
            <text class="cl-info-text">{{item.travelTime}} 出发</text>
          </view>
          <view class="cl-info-item">
            <image class="cl-info-icon" src="/assets/icons/custom-list/cl-clock.png" mode="aspectFit" />
            <text class="cl-info-text">{{item.travelDays}}</text>
          </view>
          <view class="cl-info-item">
            <image class="cl-info-icon" src="/assets/icons/custom-list/cl-people.png" mode="aspectFit" />
            <text class="cl-info-text">{{item.totalPeople}}人</text>
          </view>
          <view class="cl-info-item">
            <image class="cl-info-icon" src="/assets/icons/custom-list/cl-money.png" mode="aspectFit" />
            <text class="cl-info-text">{{item.budgetDisplay}}</text>
          </view>
        </view>

        <!-- 底部：提交时间 + CTA 按钮 -->
        <view class="cl-card__footer">
          <text class="cl-card__time">{{item.createdAtDisplay}}</text>
          <view
            class="cl-cta cl-cta--{{item.ctaClass}}"
            catchtap="handleCtaTap"
            data-id="{{item.id}}"
            data-status="{{item.status}}"
          >
            <text>{{item.ctaText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="cl-loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="cl-loading" wx:elif="{{finished && list.length}}">
      <text>没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="cl-empty" wx:if="{{!loading && !list.length}}">
      <view class="cl-empty__icon">📋</view>
      <text class="cl-empty__text">暂无定制需求</text>
      <text class="cl-empty__hint">点击右下角 + 新建定制</text>
    </view>

    <view style="height: calc(120rpx + env(safe-area-inset-bottom));"></view>
  </view>

  <!-- 悬浮新建按钮（FAB） -->
  <view class="cl-fab" bindtap="handleCreateNew">
    <image class="cl-fab__icon" src="/assets/icons/custom-list/fab-plus.png" mode="aspectFit" />
  </view>

</view>
