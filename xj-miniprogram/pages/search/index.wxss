/**
 * 搜索页样式
 */

.page-search {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 搜索框区域 ===== */
.search-bar-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: rgba(248, 246, 246, 0.92);
  border-bottom: 1rpx solid #e5e7eb;
}

.search-cancel {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4a3b39;
  padding: 8rpx 0;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #f2ebea;
  border-radius: 40rpx;
  padding: 0 32rpx 0 24rpx;
  gap: 16rpx;
}

.search-bar--active {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-bar__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

.search-bar__placeholder {
  color: #9c8e8b;
  font-size: 28rpx;
}

.search-bar__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* ===== 排序筛选栏 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: rgba(248, 246, 246, 0.95);
  border-bottom: 1rpx solid #e5e7eb;
}

.filter-tabs {
  display: flex;
  gap: 48rpx;
  align-items: center;
}

.filter-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.filter-tab--active {
  color: #0f172a;
  font-weight: 500;
}

.filter-tab__line {
  width: 32rpx;
  height: 8rpx;
  background: #ec3713;
  border-radius: 9999rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f3f4f6;
  border-radius: 9999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* ===== 默认态 ===== */
.section {
  padding: 40rpx 32rpx 16rpx;
}

.section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section__title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4a3b39;
}

.section__action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 50%;
}

.section__delete-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

/* 热门搜索网格 */
.hot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

/* Rank 1 */
.hot-item--rank1 {
  background: #fff;
  border-color: rgba(236, 55, 19, 0.1);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  background-image: linear-gradient(to right, rgba(236, 55, 19, 0.08), transparent);
}

/* Rank 2 */
.hot-item--rank2 {
  background: #fff;
  border-color: rgba(236, 55, 19, 0.1);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  background-image: linear-gradient(to right, rgba(236, 55, 19, 0.04), transparent);
}

/* Rank 3 */
.hot-item--rank3 {
  background: #fff;
  border-color: rgba(236, 55, 19, 0.1);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* Rank 4-6 */
.hot-item--other {
  background: rgba(242, 235, 234, 0.5);
}

.hot-item__rank {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #9c8e8b;
  flex-shrink: 0;
}

.hot-item__rank--1 {
  background: #ec3713;
  color: #fff;
  border-radius: 8rpx;
}

.hot-item__rank--2 {
  background: rgba(236, 55, 19, 0.8);
  color: #fff;
  border-radius: 8rpx;
}

.hot-item__rank--3 {
  background: rgba(236, 55, 19, 0.6);
  color: #fff;
  border-radius: 8rpx;
}

.hot-item__name {
  font-size: 28rpx;
  color: #4a3b39;
  font-weight: 500;
}

/* 分隔线 */
.section-divider {
  height: 16rpx;
  background: rgba(242, 235, 234, 0.3);
  margin-top: 8rpx;
}

/* 历史记录标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #f2ebea;
  color: #4a3b39;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 搜索结果 ===== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.result-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.result-count__text {
  font-size: 24rpx;
  color: #6b7280;
}

.result-count__num {
  color: #ec3713;
  font-weight: 700;
}

.xj-badge {
  background: rgba(236, 55, 19, 0.1);
  color: #ec3713;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.result-list {
  padding: 0 32rpx 32rpx;
}

/* 结果卡片 */
.result-card {
  background: var(--color-bg-card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.result-card__cover {
  position: relative;
  width: 100%;
}

.result-card__image {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #e5e7eb;
}

.result-card__score {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.result-card__score-icon {
  font-size: 22rpx;
  color: #facc15;
}

.result-card__score-num {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.result-card__body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
}

.result-card__tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.result-card__tag {
  font-size: 20rpx;
  color: #4b5563;
  background: #f3f4f6;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.result-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.result-card__meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.result-card__price {
  display: flex;
  align-items: baseline;
  color: #ec3713;
}

.result-card__price-unit {
  font-size: 24rpx;
  font-weight: 700;
}

.result-card__price-num {
  font-size: 40rpx;
  font-weight: 700;
}

.result-card__price-suffix {
  font-size: 22rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: var(--color-primary);
}

.load-more--end {
  text-align: center;
  padding: 48rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
}
