<!--
  行程列表页
  区块：待出行 + 为你推荐
-->
<view class="page-trip">

  <!-- 顶部导航栏 -->
  <nav-bar
    title="我的行程"
    background="rgba(255, 255, 255, 0.9)"
    border
    showBack="{{false}}"
    fixed
  >
    <view slot="right" class="nav-right-actions">
      <view class="nav-icon-btn" bindtap="handleNotificationTap">
        <image class="nav-icon" src="/assets/icons/trip/notification.png" mode="aspectFit" />
      </view>
      <view class="nav-icon-btn" bindtap="handleHistoryTap">
        <image class="nav-icon" src="/assets/icons/trip/history.png" mode="aspectFit" />
      </view>
    </view>
  </nav-bar>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <xj-loading text="加载中..." vertical />
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>

    <!-- 待出行区块 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-title-bar"></view>
          <text class="section-title">待出行</text>
        </view>
        <view class="trip-count-badge" wx:if="{{tripList.length > 0}}">
          <text class="trip-count-text">{{tripList.length}} 个行程</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{tripEmpty}}">
        <xj-empty type="order" description="暂无待出行的行程" />
        <view class="empty-btn" bindtap="handleExplore">去逛逛</view>
      </view>

      <!-- 行程卡片列表 -->
      <view class="trip-list" wx:else>
        <view
          class="active-trip-card"
          wx:for="{{tripList}}"
          wx:key="id"
        >
          <!-- 图片区 -->
          <view class="active-trip-card__image-wrap">
            <image
              class="active-trip-card__image"
              src="{{item.productImage || item.coverImage || '/assets/images/placeholder/route.png'}}"
              mode="aspectFill"
            />
            <view class="active-trip-card__gradient"></view>
            <!-- 倒计时徽章 -->
            <view class="countdown-badge">
              <image class="countdown-badge__icon" src="/assets/icons/trip/clock.png" mode="aspectFit" />
              <text class="countdown-badge__text">{{item.countdownText}}</text>
            </view>
            <!-- 底部标题覆盖 -->
            <view class="active-trip-card__overlay">
              <text class="active-trip-card__title">{{item.productName}}</text>
              <view class="active-trip-card__location" wx:if="{{item.location}}">
                <image class="location-icon" src="/assets/icons/trip/location.png" mode="aspectFit" />
                <text class="location-text">{{item.location}}</text>
              </view>
            </view>
          </view>

          <!-- 详情区 -->
          <view class="active-trip-card__details">
            <view class="trip-meta-row">
              <view class="departure-pill">
                <text class="departure-pill__label">出发</text>
                <text class="departure-pill__date">{{item.startDateText}}</text>
              </view>
              <view class="trip-divider"></view>
              <view class="companions">
                <text class="companions__label">同行伙伴</text>
                <text class="companions__text">{{item.peopleText || '仅自己'}}</text>
              </view>
            </view>

            <!-- 操作按钮行 -->
            <view class="trip-action-row">
              <view
                class="trip-detail-btn"
                data-id="{{item.id}}"
                bindtap="handleTripTap"
              >
                <text class="trip-detail-btn__text">查看详情</text>
                <image class="trip-detail-btn__arrow" src="/assets/icons/trip/arrow.png" mode="aspectFit" />
              </view>
              <view
                class="trip-share-btn"
                data-id="{{item.id}}"
                catchtap="handleShareTap"
              >
                <image class="trip-share-btn__icon" src="/assets/icons/trip/share.png" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 为你推荐区块 -->
    <view class="section" wx:if="{{recommendList.length > 0}}">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-title-bar"></view>
          <text class="section-title">为你推荐</text>
        </view>
        <view class="section-more" bindtap="handleViewAllRecommend">
          <text class="section-more__text">查看全部</text>
          <image class="section-more__icon" src="/assets/icons/trip/chevron.png" mode="aspectFit" />
        </view>
      </view>

      <!-- 两列卡片网格 -->
      <view class="recommend-grid">
        <view
          class="recommend-card"
          wx:for="{{recommendList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="handleRecommendTap"
        >
          <view class="recommend-card__img-wrap">
            <image
              class="recommend-card__img"
              src="{{item.coverImage || '/assets/images/placeholder/route.png'}}"
              mode="aspectFill"
              lazy-load
            />
            <view class="recommend-card__tag-overlay" wx:if="{{item.category || (item.tags && item.tags.length)}}">
              <text class="recommend-card__tag">{{item.category || item.tags[0]}}</text>
            </view>
          </view>
          <view class="recommend-card__content">
            <text class="recommend-card__title">{{item.name}}</text>
            <view class="recommend-card__bottom">
              <text class="recommend-card__duration">{{item.daysText || (item.days + '天')}}</text>
              <text class="recommend-card__price">¥{{item.priceText || item.minPrice || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>
