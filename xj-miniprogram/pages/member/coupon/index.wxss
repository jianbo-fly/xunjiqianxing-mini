/**
 * 我的优惠券
 */

.page-coupon {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== Tabs ===== */
.coupon-tabs {
  position: sticky;
  z-index: 10;
  background: var(--color-bg-card);
  display: flex;
  border-bottom: 2rpx solid var(--color-border-light);
}

.coupon-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  position: relative;
}

.coupon-tab--active {
  color: var(--color-primary);
  font-weight: 600;
}

.coupon-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
}

/* ===== 中心加载 ===== */
.coupon-center {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
}

/* ===== 列表区 ===== */
.coupon-scroll {
  height: calc(100vh - var(--nav-height, 88px) - 88rpx);
}

.coupon-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 优惠券卡片 ===== */
.coupon-card {
  position: relative;
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-btn);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.coupon-card--inactive {
  opacity: 0.55;
}

/* 左侧红色区域 */
.coupon-card__left {
  width: 200rpx;
  flex-shrink: 0;
  background: linear-gradient(145deg, #ec3713, #ff6035);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 20rpx;
  gap: 10rpx;
}

.coupon-card__amount-wrap {
  display: flex;
  align-items: baseline;
  color: var(--color-text-inverse);
  gap: 2rpx;
}

.coupon-card__symbol {
  font-size: 26rpx;
  font-weight: 600;
}

.coupon-card__amount {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-card__condition {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

/* 中间虚线票据样式 */
.coupon-card__sep {
  width: 32rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  background: var(--color-bg-card);
}

.coupon-card__notch {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  background: var(--color-bg-page);
  border-radius: 50%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
}

.coupon-card__notch--top {
  top: -16rpx;
}

.coupon-card__notch--bottom {
  bottom: -16rpx;
}

.coupon-card__dashes {
  flex: 1;
  border-left: 3rpx dashed var(--color-border-light);
  margin: 24rpx 0;
}

/* 右侧信息区 */
.coupon-card__right {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.coupon-card__scope {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-ultralight);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  align-self: flex-start;
}

.coupon-card__expiry {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 已使用/已过期印章 */
.coupon-card__stamp {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%) rotate(-12deg);
  border: 4rpx solid var(--color-border-medium);
  border-radius: var(--radius-xs);
  padding: 8rpx 20rpx;
}

.coupon-card__stamp-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-border-medium);
  letter-spacing: 4rpx;
}

/* ===== 底部提示 ===== */
.coupon-no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
