/**
 * 我的优惠券
 */

.page-coupon {
  min-height: 100vh;
  background: #f8f6f6;
}

/* ===== Tabs ===== */
.coupon-tabs {
  position: sticky;
  z-index: 10;
  background: #fff;
  display: flex;
  border-bottom: 2rpx solid #f3f4f6;
}

.coupon-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.coupon-tab--active {
  color: #ec3713;
  font-weight: 600;
}

.coupon-tab--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #ec3713;
  border-radius: 99rpx;
}

/* ===== 中心加载 ===== */
.coupon-center {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
}

/* ===== 列表区 ===== */
.coupon-scroll {
  height: calc(100vh - var(--nav-height, 88px) - 88rpx);
}

.coupon-list {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 优惠券卡片 ===== */
.coupon-card {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.coupon-card--inactive {
  opacity: 0.55;
}

/* 左侧红色区域 */
.coupon-card__left {
  width: 200rpx;
  flex-shrink: 0;
  background: linear-gradient(145deg, #ec3713, #ff6035);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 20rpx;
  gap: 10rpx;
}

.coupon-card__amount-wrap {
  display: flex;
  align-items: baseline;
  color: #fff;
  gap: 2rpx;
}

.coupon-card__symbol {
  font-size: 26rpx;
  font-weight: 600;
}

.coupon-card__amount {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-card__condition {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

/* 中间虚线票据样式 */
.coupon-card__sep {
  width: 32rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  background: #fff;
}

.coupon-card__notch {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  background: #f8f6f6;
  border-radius: 50%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
}

.coupon-card__notch--top {
  top: -16rpx;
}

.coupon-card__notch--bottom {
  bottom: -16rpx;
}

.coupon-card__dashes {
  flex: 1;
  border-left: 3rpx dashed #f0f0f0;
  margin: 24rpx 0;
}

/* 右侧信息区 */
.coupon-card__right {
  flex: 1;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.coupon-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.coupon-card__scope {
  font-size: 20rpx;
  color: #ec3713;
  background: #feece9;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  align-self: flex-start;
}

.coupon-card__expiry {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 已使用/已过期印章 */
.coupon-card__stamp {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%) rotate(-12deg);
  border: 4rpx solid #d1d5db;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.coupon-card__stamp-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d5db;
  letter-spacing: 4rpx;
}

/* ===== 底部提示 ===== */
.coupon-no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
