/**
 * 编辑出行人页
 */

.page-traveler-edit {
  min-height: 100vh;
  background: #f8f6f6;
  padding-bottom: 160rpx;
}

/* ===== 加载 ===== */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

/* ===== 表单容器 ===== */
.form-container {
  padding: 32rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 表单区块 ===== */
.form-section {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f3f4f6;
}

.section-label {
  padding: 24rpx 32rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: var(--font-weight-medium);
}

/* ===== 表单项 ===== */
.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item--switch {
  justify-content: space-between;
}

.form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #374151;
  font-weight: var(--font-weight-medium);
}

.form-label.required::before {
  content: '*';
  color: var(--color-primary);
  margin-right: 6rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  text-align: right;
}

.form-input::placeholder {
  color: #d1d5db;
}

/* ===== 选择器 ===== */
.form-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 28rpx;
  color: #111827;
}

.picker-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.35;
}

/* ===== 开关 ===== */
.form-switch {
  transform: scale(0.85);
}

/* ===== 表单提示 ===== */
.form-hint {
  padding: 0 32rpx 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

/* ===== 温馨提示 ===== */
.tips-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #f3f4f6;
  border-left: 6rpx solid rgba(236, 55, 19, 0.3);
}

.tips-title {
  font-size: 26rpx;
  font-weight: var(--font-weight-medium);
  color: #374151;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tips-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.tips-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* ===== 底部保存按钮 ===== */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  border-radius: 20rpx;
  box-shadow: 0px 8rpx 16rpx -4rpx rgba(236, 55, 19, 0.3);
}

.save-btn--disabled {
  opacity: 0.6;
}
