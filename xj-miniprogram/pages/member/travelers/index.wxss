/**
 * 常用出行人列表页
 */

.page-traveler-list {
  min-height: 100vh;
  background: #f8f6f6;
  padding-bottom: 160rpx;
}

/* ===== 加载 ===== */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

/* ===== 列表 ===== */
.traveler-list {
  padding: 48rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ===== 出行人卡片 ===== */
.traveler-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0px 4rpx 16rpx -4rpx rgba(0, 0, 0, 0.05), 0px 4rpx 8rpx -4rpx rgba(0, 0, 0, 0.03);
  position: relative;
}

/* 卡片主体内边距 */
.card-body {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 默认徽章 — 右上角，左下圆角 */
.default-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: rgba(236, 55, 19, 0.1);
  border-radius: 0 24rpx 0 24rpx;
  padding: 8rpx 24rpx;
}

.default-badge__text {
  font-size: 24rpx;
  color: #ec3713;
}

/* ===== 卡片头部：头像 + 姓名 ===== */
.card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 头像圆形 */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar--primary {
  background: rgba(236, 55, 19, 0.12);
}

.avatar--gray {
  background: #f3f4f6;
}

.avatar__text {
  font-size: 36rpx;
  font-weight: var(--font-weight-medium);
  color: #ec3713;
}

.avatar--gray .avatar__text {
  color: #6b7280;
}

.name-wrap {
  flex: 1;
}

.traveler-name {
  font-size: 36rpx;
  font-weight: var(--font-weight-medium);
  color: #111827;
}

/* ===== 信息区（竖排） ===== */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 图标 + 标签横排 */
.info-item__label-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-item__icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

.info-item__label {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 值（在标签下方，左缩进与标签对齐） */
.info-item__value {
  font-size: 28rpx;
  color: #374151;
  padding-left: 44rpx;
  letter-spacing: 0.5rpx;
}

/* ===== 操作按钮（顶部分隔线） ===== */
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #f3f4f6;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.action-btn__icon {
  width: 28rpx;
  height: 28rpx;
}

.action-btn__text {
  font-size: 28rpx;
  color: #6b7280;
}

.action-btn--delete .action-btn__text {
  color: #6b7280;
}

/* ===== 底部添加按钮 ===== */
.add-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: #ec3713;
  border-radius: 16rpx;
  box-shadow: 0px 20rpx 30rpx -6rpx rgba(236, 55, 19, 0.3), 0px 8rpx 12rpx -8rpx rgba(236, 55, 19, 0.3);
}

.add-btn__icon {
  width: 40rpx;
  height: 40rpx;
}

.add-btn__text {
  font-size: 32rpx;
  color: #fff;
  font-weight: var(--font-weight-medium);
}
