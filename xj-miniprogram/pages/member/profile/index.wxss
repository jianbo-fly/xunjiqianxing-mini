/**
 * 个人资料页样式
 */

.page-profile {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-top: var(--spacing-md);
}

/* button 重置，让头像行和 view 行视觉一致 */
.profile-item--btn {
  border-radius: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
}

.profile-item--btn::after {
  border: none;
}

.profile-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--page-padding);
  background: var(--color-bg-card);
  border-bottom: 2rpx solid var(--color-divider);
}

.profile-item:first-child {
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.profile-item:last-child {
  border-bottom: none;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
}

.profile-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
}

.profile-right {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.profile-input {
  text-align: right;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  max-width: 400rpx;
}

.profile-value {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.profile-arrow {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
  margin-left: 18rpx;
  opacity: 0.35;
}
