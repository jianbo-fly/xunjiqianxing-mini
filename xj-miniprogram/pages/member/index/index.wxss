/**
 * 我的 - 个人中心
 */

.page-member {
  min-height: 100vh;
  background: #f8f6f6;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.header {
  background: linear-gradient(180deg, rgba(236, 55, 19, 0.10) 0%, #f8f6f6 100%);
  border-radius: 0 0 32rpx 32rpx;
  padding: 0 32rpx 32rpx;
}

.status-bar {
  /* height set via inline style */
}

/* 右侧操作按钮 */
.header-actions {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 0;
}

.action-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

/* 用户信息行 */
.profile-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
  display: block;
}

.avatar-edit-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  width: 22rpx;
  height: 22rpx;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  background: linear-gradient(to right, #1f2937, #111827);
  border-radius: 9999rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.vip-badge-star-icon {
  width: 24rpx;
  height: 22rpx;
}

.vip-badge-text {
  font-size: 24rpx;
  color: #ffd700;
  font-weight: 500;
}

.login-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 资产统计卡片行 */
.stats-row {
  display: flex;
  gap: 32rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0;
  background: #ffffff;
  border: 1rpx solid #f3f4f6;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.stat-divider {
  display: none;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 24rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* ===== 我的订单卡片 ===== */
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.card-hd-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.card-hd-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-hd-more-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.card-hd-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-left: 4rpx;
  opacity: 0.5;
}

.order-tabs {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0 28rpx;
}

.order-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.order-tab-icon-wrap {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 有背景色的订单 tab（待付款/待出行） */
.order-tab-bg {
  background: rgba(236, 55, 19, 0.05);
  border-radius: 16rpx;
}

.order-tab-icon {
  width: 38rpx;
  height: 36rpx;
}

/* 待确认、已完成 使用整体 overlay 图片 */
.order-tab-icon-full {
  width: 68rpx;
  height: 68rpx;
}

.order-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ec3713;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.order-tab-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* ===== 会员 Banner ===== */
.member-banner {
  margin: 24rpx 32rpx 0;
  background: linear-gradient(to right, #2c2c2c, #1a1a1a);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.2),
              0 4rpx 8rpx -4rpx rgba(0, 0, 0, 0.2);
}

/* 右侧金色装饰光晕 */
.member-banner-deco {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 256rpx;
  background: linear-gradient(to left, rgba(255, 215, 0, 0.10), rgba(255, 215, 0, 0));
  pointer-events: none;
}

.member-banner-left {
  flex: 1;
  min-width: 0;
}

.member-banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffd700;
  display: block;
  margin-bottom: 8rpx;
}

.member-banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  display: block;
}

.member-open-btn {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(to right, #ffd700, #fdb931);
  border-radius: 9999rpx;
  box-shadow: 0 20rpx 30rpx -6rpx rgba(0, 0, 0, 0.2),
              0 8rpx 12rpx -8rpx rgba(0, 0, 0, 0.2);
}

.member-open-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
}

/* ===== 功能菜单 ===== */
.menu-card {
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-divider {
  height: 1rpx;
  background: #f9fafb;
  margin: 0 32rpx;
}

.menu-icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

/* 图标背景颜色 — 对齐 Figma */
.menu-icon-red    { background: rgba(236, 55,  19,  0.10); }
.menu-icon-blue   { background: rgba(59,  130, 246, 0.10); }
.menu-icon-green  { background: rgba(34,  197, 94,  0.10); }
.menu-icon-purple { background: rgba(168, 85,  247, 0.10); }
.menu-icon-orange { background: rgba(249, 115, 22,  0.10); }
.menu-icon-gray   { background: rgba(107, 114, 128, 0.10); }

.menu-icon {
  width: 34rpx;
  height: 34rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
}

.menu-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-right: 8rpx;
}

.menu-chevron {
  width: 20rpx;
  height: 20rpx;
  opacity: 0.5;
}

/* ===== 页脚（退出登录 + 版本号） ===== */
.footer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 0 16rpx;
}

.logout-btn {
  padding: 8rpx 0;
}

.logout-btn-text {
  font-size: 28rpx;
  color: #ec3713;
  font-weight: 500;
}

.version-text {
  font-size: 20rpx;
  color: #d1d5db;
}

/* ===== 我的定制卡片 ===== */
.custom-tabs {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0 4rpx;
}

.custom-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.custom-tab-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 三种状态背景色，对齐 Figma 定制列表设计 */
.custom-tab-bg--pending   { background: #EFF6FF; }
.custom-tab-bg--following { background: #FFF7ED; }
.custom-tab-bg--completed { background: #F0FDF4; }

.custom-tab-icon {
  width: 40rpx;
  height: 40rpx;
}
