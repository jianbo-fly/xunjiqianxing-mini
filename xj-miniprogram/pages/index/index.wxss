.page-index {
  min-height: 100vh;
  background: var(--color-bg-page);
  /* 底部留出 tab-bar 空间 */
  padding-bottom: var(--tab-bar-height);
}

/* ===== 顶部栏 ===== */
.top-bar {
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 状态栏下方：logo + 操作按钮横排 */
.top-bar__content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
}

.top-bar__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.top-bar__logo {
  width: 64rpx;
  height: 64rpx;
}

.top-bar__title {
  font-size: 36rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.top-bar__right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 消息通知 */
.notification {
  position: relative;
  padding: 8rpx;
}

.notification__icon {
  width: 32rpx;
  height: 40rpx;
}

.notification__dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-error);
  border-radius: 50%;
  border: 2rpx solid var(--color-bg-card);
}

/* ===== 主内容区 ===== */
.main-content {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 左侧城市选择器 */
.search-bar__city {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 26rpx 24rpx 32rpx;
  border-right: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.search-bar__city-icon {
  width: 26rpx;
  height: 32rpx;
  opacity: 0.7;
}

.search-bar__city-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* 下拉箭头（CSS三角形） */
.search-bar__city-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--color-text-tertiary);
  margin-left: 2rpx;
}

/* 右侧搜索区 */
.search-bar__input-area {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}

.search-bar__search-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

.search-bar__placeholder {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* ===== 轮播图 ===== */
.banner-section {
  position: relative;
  /* opacity 淡出效果，不影响 layout */
}

.banner-swiper {
  height: 358rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx;
}

.banner-tag-wrap {
  margin-bottom: 16rpx;
}

.banner-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(236, 55, 19, 0.85);
  border-radius: var(--radius-xs);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4rpx);
}

.banner-title {
  font-size: 40rpx;
  color: var(--color-text-inverse);
  line-height: 1.3;
  font-weight: var(--font-weight-medium);
}

.banner-placeholder {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, #D6E9F8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

/* 轮播指示点 */
.banner-dots {
  position: absolute;
  bottom: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 12rpx;
  z-index: 5;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.banner-dot--active {
  width: 32rpx;
  border-radius: var(--radius-full);
  background: var(--color-text-inverse);
}

/* ===== 功能入口 ===== */
.entry-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 8rpx;
  box-shadow: var(--shadow-sm);
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 0;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.entry-item--hover .entry-icon-bg {
  transform: scale(0.88);
  opacity: 0.75;
}

.entry-item--hover .entry-name {
  opacity: 0.6;
}

.entry-icon-bg {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
}


.entry-name {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-body);
  line-height: 1.4;
}

/* ===== 热门路线 ===== */
.hot-routes {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-top: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title-bar {
  width: 8rpx;
  height: 40rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
}

.section-title {
  font-size: 36rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.section-more {
  display: flex;
  align-items: center;
}

.section-more-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.section-more-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.5;
  margin-left: 4rpx;
}

/* ===== 瀑布流 ===== */
.waterfall {
  display: flex;
  gap: 24rpx;
}

.waterfall__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 路线卡片 ===== */
.route-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.route-card__image-wrap {
  position: relative;
  width: 100%;
  /* 图片加载占位骨架屏 */
  background: linear-gradient(
    90deg,
    var(--color-bg-gray) 25%,
    var(--color-border-light) 50%,
    var(--color-bg-gray) 75%
  );
  background-size: 200% 100%;
  animation: skeleton 1.5s ease infinite;
}

/* 底部渐变遮罩：提升 location 标签可读性 */
.route-card__image-wrap::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.15) 60%, transparent 100%);
  pointer-events: none;
  z-index: 2;
}

.route-card__image {
  width: 100%;
  height: 340rpx;
  position: relative;
  z-index: 1;
}

.route-card__location {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  background: var(--color-overlay-dark);
  backdrop-filter: blur(12rpx);
  border-radius: var(--radius-full);
  z-index: 3;
}

.route-card__location-icon {
  width: 14rpx;
  height: 16rpx;
  opacity: 0.9;
}

.route-card__location-text {
  font-size: 20rpx;
  color: var(--color-text-inverse);
}

.route-card__info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.route-card__title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.route-card__tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.route-card__tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
  font-size: 20rpx;
}

.route-card__tag--primary {
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-border);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.route-card__tag--gray {
  background: var(--tag-gray-bg);
  color: var(--tag-gray-text);
}

.route-card__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.route-card__sales {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.route-card__price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.route-card__price-symbol {
  font-size: 24rpx;
  font-weight: var(--font-weight-bold);
}

.route-card__price-value {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.route-card__price-unit {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-normal);
  margin-left: 2rpx;
}

.route-card__price-origin {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  text-decoration: line-through;
  margin-left: 6rpx;
  font-weight: var(--font-weight-normal);
}

/* ===== 空状态（由 xj-empty 组件处理，此处留余量） ===== */

/* ===== 城市选择弹窗 ===== */
.city-picker-mask {
  position: fixed;
  inset: 0;
  background: var(--color-bg-mask);
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.city-picker-panel {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  height: 88vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.city-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.city-picker-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.city-picker-close {
  padding: 8rpx;
}

/* 滚动内容区 */
.city-picker-scroll {
  flex: 1;
  overflow: hidden;
  padding-right: 56rpx; /* 给右侧索引栏留位 */
}

/* 分组区块 */
.city-section {
  padding: 28rpx 40rpx 8rpx;
}

.city-section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.city-section-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.city-section-clear {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 城市格子（热门/历史） */
.city-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.city-chip {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-gray);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text-body);
}

.city-chip--active {
  background: var(--color-primary-ultralight);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 500;
}

/* 字母分组标题 */
.city-letter-header {
  padding: 12rpx 40rpx;
  background: var(--color-bg-gray);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* 城市列表项 */
.city-list-item {
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
  border-bottom: 1rpx solid var(--color-border-light);
}

.city-list-item--active {
  color: var(--color-primary);
  font-weight: 500;
}

/* 右侧字母索引栏 */
.city-index-bar {
  position: absolute;
  right: 0;
  top: 120rpx;
  bottom: 0;
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 0;
}

.city-index-letter {
  font-size: 20rpx;
  color: var(--color-primary);
  line-height: 1.6;
  padding: 2rpx 8rpx;
}

/* ===== 在线客服悬浮按钮 ===== */
.customer-service {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--tab-bar-height) + 40rpx);
  width: 92rpx;
  height: 88rpx;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.service-icon {
  width: 40rpx;
  height: 36rpx;
}
