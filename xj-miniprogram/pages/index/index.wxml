<view class="page-index">
  <!-- 顶部栏 -->
  <view class="top-bar">
    <!-- 状态栏占位（高度由 JS 动态设置，兼容所有机型） -->
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="top-bar__content">
      <view class="top-bar__left">
        <image class="top-bar__logo" src="/assets/images/logo.png" mode="aspectFit" />
        <text class="top-bar__title">寻迹千行</text>
      </view>
      <!-- 消息入口：右侧 padding 与胶囊按钮对齐，避免被遮挡 -->
      <view class="top-bar__right" style="padding-right: {{menuButtonLeft}}rpx;">
        <view class="notification" bindtap="handleMessageTap">
          <image class="notification__icon" src="/assets/icons/common/message.png" mode="aspectFit" />
          <view wx:if="{{unreadCount > 0}}" class="notification__dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 搜索栏 -->
    <view class="search-bar">
      <!-- 出发城市选择器 -->
      <view class="search-bar__city" bindtap="handleCityTap">
        <image class="search-bar__city-icon" src="/assets/icons/common/location.png" mode="aspectFit" />
        <text class="search-bar__city-text">{{departureCity}}出发</text>
        <view class="search-bar__city-arrow"></view>
      </view>
      <!-- 搜索输入区 -->
      <view class="search-bar__input-area" bindtap="handleSearchTap">
        <image class="search-bar__search-icon" src="/assets/icons/common/search.png" mode="aspectFit" />
        <text class="search-bar__placeholder">搜索目的地 / 路线 / 攻略</text>
      </view>
    </view>

    <!-- 轮播图 -->
    <view class="banner-section" style="opacity: {{bannerOpacity}};">
      <swiper
        wx:if="{{bannerVisible}}"
        class="banner-swiper"
        autoplay
        circular
        duration="500"
        interval="4000"
        bindchange="handleBannerChange"
      >
        <swiper-item
          wx:for="{{banners}}"
          wx:key="id"
          data-item="{{item}}"
          bindtap="handleBannerTap"
        >
          <view class="banner-item">
            <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view class="banner-overlay">
              <view class="banner-tag-wrap">
                <view class="banner-tag">{{item.tag || '本季热门'}}</view>
              </view>
              <view class="banner-title">{{item.title || ''}}</view>
            </view>
          </view>
        </swiper-item>
        <!-- 无数据占位 -->
        <swiper-item wx:if="{{!banners.length}}">
          <view class="banner-item banner-placeholder">
            <text>暂无活动</text>
          </view>
        </swiper-item>
      </swiper>
      <!-- 轮播指示点 -->
      <view class="banner-dots" wx:if="{{banners.length > 1}}">
        <view
          wx:for="{{banners}}"
          wx:key="id"
          class="banner-dot {{currentBanner === index ? 'banner-dot--active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="entry-card">
      <view class="entry-grid">
        <view
          class="entry-item"
          wx:for="{{entries}}"
          wx:key="id"
          data-item="{{item}}"
          bindtap="handleEntryTap"
          hover-class="entry-item--hover"
          hover-stay-time="100"
        >
          <view class="entry-icon-bg">
            <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <text class="entry-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 热门路线 -->
    <view class="hot-routes">
      <view class="section-header">
        <view class="section-title-wrap">
          <view class="section-title-bar"></view>
          <text class="section-title">热门路线</text>
        </view>
        <view class="section-more" bindtap="handleMoreTap">
          <text class="section-more-text">查看全部</text>
          <image class="section-more-arrow" src="/assets/icons/common/arrow-right.png" mode="aspectFit" />
        </view>
      </view>

      <!-- 瀑布流布局 -->
      <view class="waterfall" wx:if="{{leftRoutes.length || rightRoutes.length}}">
        <!-- 左列 -->
        <view class="waterfall__col">
          <view
            class="route-card"
            wx:for="{{leftRoutes}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="handleRouteTap"
          >
            <view class="route-card__image-wrap">
              <image
                class="route-card__image"
                src="{{item.coverImage}}"
                mode="aspectFill"
                lazy-load
              />
              <view class="route-card__location" wx:if="{{item.cityName}}">
                <image class="route-card__location-icon" src="/assets/icons/common/location.png" mode="aspectFit" />
                <text class="route-card__location-text">{{item.cityName}}</text>
              </view>
            </view>
            <view class="route-card__info">
              <text class="route-card__title">{{item.name}}</text>
              <view class="route-card__tags" wx:if="{{item.tags && item.tags.length}}">
                <text
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:for-index="tagIdx"
                  wx:key="tagIdx"
                  wx:if="{{tagIdx < 2}}"
                  class="route-card__tag {{tagIdx === 0 ? 'route-card__tag--primary' : 'route-card__tag--gray'}}"
                >{{tag}}</text>
              </view>
              <view class="route-card__bottom">
                <view class="route-card__sales-wrap">
                  <text class="route-card__sales">已售 {{item.salesText || item.salesCount || 0}}</text>
                </view>
                <view class="route-card__price">
                  <text class="route-card__price-symbol">¥</text>
                  <text class="route-card__price-value">{{item.priceText || item.minPrice || 0}}</text>
                  <text class="route-card__price-origin" wx:if="{{item.hasOriginal}}">¥{{item.originalPrice}}</text>
                  <text class="route-card__price-unit">起</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 右列 -->
        <view class="waterfall__col">
          <view
            class="route-card"
            wx:for="{{rightRoutes}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="handleRouteTap"
          >
            <view class="route-card__image-wrap">
              <image
                class="route-card__image"
                src="{{item.coverImage}}"
                mode="aspectFill"
                lazy-load
              />
              <view class="route-card__location" wx:if="{{item.cityName}}">
                <image class="route-card__location-icon" src="/assets/icons/common/location.png" mode="aspectFit" />
                <text class="route-card__location-text">{{item.cityName}}</text>
              </view>
            </view>
            <view class="route-card__info">
              <text class="route-card__title">{{item.name}}</text>
              <view class="route-card__tags" wx:if="{{item.tags && item.tags.length}}">
                <text
                  wx:for="{{item.tags}}"
                  wx:for-item="tag"
                  wx:for-index="tagIdx"
                  wx:key="tagIdx"
                  wx:if="{{tagIdx < 2}}"
                  class="route-card__tag {{tagIdx === 0 ? 'route-card__tag--primary' : 'route-card__tag--gray'}}"
                >{{tag}}</text>
              </view>
              <view class="route-card__bottom">
                <view class="route-card__sales-wrap">
                  <text class="route-card__sales">已售 {{item.salesText || item.salesCount || 0}}</text>
                </view>
                <view class="route-card__price">
                  <text class="route-card__price-symbol">¥</text>
                  <text class="route-card__price-value">{{item.priceText || item.minPrice || 0}}</text>
                  <text class="route-card__price-origin" wx:if="{{item.hasOriginal}}">¥{{item.originalPrice}}</text>
                  <text class="route-card__price-unit">起</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <xj-empty
        wx:else
        card-mode="{{true}}"
        type="route"
        description="暂无热门路线"
        subtitle="换个关键词或去看看热门线路吧"
        button-text="查看全部路线"
        bind:action="handleMoreTap"
      />
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 城市选择弹窗 -->
  <view class="city-picker-mask" wx:if="{{showCityPicker}}" bindtap="handleCloseCityPicker">
    <view class="city-picker-panel" catchtap="">

      <!-- 标题栏 -->
      <view class="city-picker-header">
        <text class="city-picker-title">选择出发城市</text>
        <view class="city-picker-close" bindtap="handleCloseCityPicker">
          <image src="/assets/icons/common/close.png" mode="aspectFit" style="width:36rpx;height:36rpx;" />
        </view>
      </view>

      <!-- 内容滚动区 -->
      <scroll-view
        class="city-picker-scroll"
        scroll-y
        scroll-into-view="{{cityScrollTo}}"
        scroll-with-animation
      >
        <!-- 历史选择 -->
        <view wx:if="{{cityHistory.length > 0}}" class="city-section">
          <view class="city-section-hd">
            <text class="city-section-label">历史选择</text>
            <text class="city-section-clear" bindtap="handleClearCityHistory">清空</text>
          </view>
          <view class="city-grid">
            <view
              wx:for="{{cityHistory}}"
              wx:key="*this"
              class="city-chip {{departureCity === item ? 'city-chip--active' : ''}}"
              bindtap="handleCitySelect"
              data-city="{{item}}"
            >{{item}}</view>
          </view>
        </view>

        <!-- 热门出发地 -->
        <view class="city-section">
          <view class="city-section-hd">
            <text class="city-section-label">热门出发地</text>
          </view>
          <view class="city-grid">
            <view
              wx:for="{{hotCities}}"
              wx:key="*this"
              class="city-chip {{departureCity === item ? 'city-chip--active' : ''}}"
              bindtap="handleCitySelect"
              data-city="{{item}}"
            >{{item}}</view>
          </view>
        </view>

        <!-- 按字母分组 -->
        <view
          wx:for="{{cityGroups}}"
          wx:key="letter"
          id="city-letter-{{item.letter}}"
        >
          <view class="city-letter-header">{{item.letter}}</view>
          <view
            wx:for="{{item.cities}}"
            wx:for-item="city"
            wx:key="*this"
            class="city-list-item {{departureCity === city ? 'city-list-item--active' : ''}}"
            bindtap="handleCitySelect"
            data-city="{{city}}"
          >{{city}}</view>
        </view>

        <view style="height:40rpx;"></view>
      </scroll-view>

      <!-- 右侧字母索引 -->
      <view class="city-index-bar">
        <text
          wx:for="{{cityIndexLetters}}"
          wx:key="*this"
          class="city-index-letter"
          bindtap="handleLetterTap"
          data-letter="{{item}}"
        >{{item}}</text>
      </view>

    </view>
  </view>

  <!-- 在线客服悬浮按钮 -->
  <view class="customer-service" bindtap="handleServiceTap">
    <image class="service-icon" src="/assets/icons/common/service.png" mode="aspectFit" />
  </view>
</view>
<xj-toast id="xj-toast"/>
