/**
 * 订单列表页样式
 */

.page-order-list {
  min-height: 100vh;
  background: #f8f6f6;
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* ===== 空状态按钮 ===== */
.empty-action {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: #ec3713;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 16rpx;
}

/* ===== Tab 吸顶栏 ===== */
.order-tabs {
  position: sticky;
  z-index: 99;
  background: #ffffff;
  display: flex;
  border-bottom: 1rpx solid #f3f4f6;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.tab-item__text {
  font-size: 28rpx;
  color: #9ca3af;
  line-height: 1;
}

.tab-item--active .tab-item__text {
  color: #111827;
  font-weight: 600;
}

/* 红色下划线指示器 */
.tab-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #ec3713;
  border-radius: 9999rpx;
}

/* ===== 订单列表容器 ===== */
.order-list {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 订单卡片 ===== */
.order-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 卡片头部 */
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.order-no {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 状态徽章 */
.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status-badge__text {
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge--orange {
  background: #fff7ed;
}
.status-badge--orange .status-badge__text {
  color: #f97316;
}

.status-badge--primary {
  background: #fff0ed;
}
.status-badge--primary .status-badge__text {
  color: #ec3713;
}

.status-badge--green {
  background: #f0fdf4;
}
.status-badge--green .status-badge__text {
  color: #10b981;
}

.status-badge--gray {
  background: #f9fafb;
}
.status-badge--gray .status-badge__text {
  color: #9ca3af;
}

.status-badge--blue {
  background: #eff6ff;
}
.status-badge--blue .status-badge__text {
  color: #3b82f6;
}

/* 卡片主体 */
.card-body {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.product-img {
  width: 160rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 4rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-sku {
  font-size: 24rpx;
  color: #6b7280;
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 卡片底部 */
.card-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid #f9fafb;
}

.amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.amount-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.amount-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ec3713;
}

.action-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* 默认操作按钮 */
.action-btn {
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
  white-space: nowrap;
}

/* 主操作按钮（去支付） */
.action-btn--primary {
  background: linear-gradient(to right, #ec3713, #ea580c);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 8rpx 16rpx -4rpx rgba(236, 55, 19, 0.3);
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

/* ===== 没有更多 ===== */
.no-more {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: #d1d5db;
}
