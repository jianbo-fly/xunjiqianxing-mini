/**
 * 订单列表页样式
 */

.page-order-list {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* ===== 空状态按钮 ===== */
.empty-action {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 20rpx var(--color-primary-border);
}

.empty-action__text {
  font-size: 28rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}

.empty-action__arrow {
  font-size: 36rpx;
  color: var(--color-text-inverse);
  line-height: 1;
}

/* ===== Tab 吸顶栏 ===== */
.order-tabs {
  position: sticky;
  z-index: 99;
  background: var(--color-bg-card);
  display: flex;
  border-bottom: 1rpx solid var(--color-border-light);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.tab-item__text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.tab-item--active .tab-item__text {
  color: var(--color-text-primary);
  font-weight: 600;
}

/* 红色下划线指示器 */
.tab-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
}

/* ===== 订单列表容器 ===== */
.order-list {
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 订单卡片 ===== */
.order-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 卡片头部 */
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-bg-gray);
}

.order-no {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 状态徽章 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status-badge__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.status-badge__text {
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge--orange {
  background: var(--color-warning-light);
}
.status-badge--orange .status-badge__text {
  color: var(--color-warning);
}

.status-badge--primary {
  background: var(--color-primary-ultralight);
}
.status-badge--primary .status-badge__text {
  color: var(--color-primary);
}

.status-badge--green {
  background: var(--color-success-light);
}
.status-badge--green .status-badge__text {
  color: #10b981;
}

.status-badge--gray {
  background: var(--color-bg-gray);
}
.status-badge--gray .status-badge__text {
  color: var(--color-text-tertiary);
}

.status-badge--blue {
  background: var(--color-info-light);
}
.status-badge--blue .status-badge__text {
  color: #3b82f6;
}

/* 卡片主体 */
.card-body {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.product-img {
  width: 160rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--color-border-light);
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 4rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-sku {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.product-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 卡片底部 */
.card-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid var(--color-bg-gray);
}

.amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.amount-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.amount-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.action-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

/* 基础操作按钮 */
.action-btn {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  font-weight: 500;
}

/* 普通/再次购买：灰色边框 */
.action-btn--ghost {
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

/* 取消：浅灰底，文字暗 */
.action-btn--cancel {
  color: var(--color-text-tertiary);
  border: 1rpx solid var(--color-border-light);
  background: var(--color-bg-gray);
}

/* 退款：橙色边框，橙色文字 */
.action-btn--danger {
  color: var(--color-warning);
  border: 1rpx solid rgba(249, 115, 22, 0.35);
  background: var(--color-warning-light);
}

/* 去支付：红色渐变主按钮 */
.action-btn--primary {
  background: var(--color-primary-gradient);
  color: var(--color-text-inverse);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(236, 55, 19, 0.35);
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

/* ===== 没有更多 ===== */
.no-more {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--color-border-medium);
}
