<!--
  订单列表页
-->
<view class="page-order-list">

  <!-- 自定义导航栏 -->
  <nav-bar title="我的订单" showBack fixed border background="rgba(255,255,255,0.95)" />

  <!-- Tab 栏（吸顶，位置在导航栏下方） -->
  <view class="order-tabs" style="top: {{navBarTotalHeight}}px;">
    <view
      class="tab-item {{currentStatus === item.status ? 'tab-item--active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="status"
      data-status="{{item.status}}"
      bindtap="handleTabChange"
    >
      <text class="tab-item__text">{{item.label}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <xj-loading text="加载中..." vertical />
  </view>

  <!-- 空状态 -->
  <xj-empty wx:elif="{{isEmpty}}" type="order">
    <view class="empty-action" bindtap="goExplore">去逛逛</view>
  </xj-empty>

  <!-- 订单列表 -->
  <view class="order-list" wx:else>
    <view class="order-card" wx:for="{{list}}" wx:key="id">

      <!-- 卡片头部：订单号 + 状态徽章 -->
      <view class="card-hd" data-id="{{item.id}}" bindtap="handleOrderTap">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <view class="status-badge status-badge--{{item.statusBadgeClass}}">
          <text class="status-badge__text">{{item.statusText}}</text>
        </view>
      </view>

      <!-- 卡片主体：图片 + 信息 -->
      <view class="card-body" data-id="{{item.id}}" bindtap="handleOrderTap">
        <image class="product-img" src="{{item.productImage}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.productName}}</text>
          <text class="product-sku" wx:if="{{item.skuName}}">{{item.skuName}}</text>
          <view class="product-meta">
            <text class="meta-item" wx:if="{{item.startDateText}}">{{item.startDateText}} 出发</text>
            <text class="meta-item" wx:if="{{item.peopleText}}">{{item.peopleText}}</text>
          </view>
        </view>
      </view>

      <!-- 卡片底部：金额 + 操作按钮 -->
      <view class="card-ft">
        <view class="amount-wrap">
          <text class="amount-label">实付</text>
          <text class="amount-value">¥{{item.payAmountText}}</text>
        </view>
        <view class="action-row">
          <view
            class="action-btn"
            wx:if="{{item.showBuyAgainBtn}}"
            data-product-id="{{item.productId}}"
            catchtap="handleBuyAgain"
          >再次购买</view>
          <view
            class="action-btn"
            wx:if="{{item.showRefundBtn}}"
            data-id="{{item.id}}"
            catchtap="handleRefund"
          >申请退款</view>
          <view
            class="action-btn"
            wx:if="{{item.showCancelBtn}}"
            data-id="{{item.id}}"
            catchtap="handleCancel"
          >取消订单</view>
          <view
            class="action-btn action-btn--primary"
            wx:if="{{item.showPayBtn}}"
            data-id="{{item.id}}"
            catchtap="handlePay"
          >去支付</view>
        </view>
      </view>

    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <xj-loading size="sm" text="加载更多..." />
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
      <text>— 没有更多了 —</text>
    </view>
  </view>

</view>
<xj-toast id="xj-toast"/>
