/**
 * 支付结果页样式
 */

.page-result {
  min-height: 100vh;
  background: #f8f6f6;
  display: flex;
  flex-direction: column;
}

.main-scroll {
  flex: 1;
}

.main-content {
  padding: 48rpx 48rpx 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 成功状态头部 ===== */
.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 64rpx;
  width: 100%;
}

.success-icon-wrap {
  margin-bottom: 48rpx;
  position: relative;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 16rpx rgba(34, 197, 94, 0.05);
}

.success-icon__check {
  font-size: 72rpx;
  color: #22c55e;
  font-weight: 700;
  line-height: 1;
}

.success-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.success-subtitle {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

.success-amount {
  display: flex;
  align-items: baseline;
  color: #111827;
}

.success-amount__unit {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.success-amount__num {
  font-size: 96rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
}

/* ===== 订单信息卡片 ===== */
.order-card {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-md);
  border: 1rpx solid #f3f4f6;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  padding: 40rpx;
  box-sizing: border-box;
}

.order-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
  margin-bottom: 32rpx;
}

.order-card__label {
  font-size: 28rpx;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.order-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-card__status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #22c55e;
}

.order-card__status-text {
  font-size: 24rpx;
  color: #22c55e;
}

/* 信息行 */
.order-card__body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 16rpx;
}

.order-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.order-row__key {
  font-size: 28rpx;
  color: #6b7280;
  flex-shrink: 0;
  min-width: 120rpx;
}

.order-row__value {
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  flex: 1;
}

.order-row__value--name {
  font-size: 28rpx;
  color: #111827;
}

/* 票样式分隔线 */
.order-card__divider {
  position: relative;
  display: flex;
  align-items: center;
  margin: 40rpx -40rpx;
}

.order-card__divider-line {
  flex: 1;
  border-top: 2rpx dashed #e5e7eb;
}

.order-card__notch {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f8f6f6;
  flex-shrink: 0;
}

/* 底部支付方式 */
.order-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.order-card__footer-key {
  font-size: 24rpx;
  color: #9ca3af;
}

.order-card__footer-value {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ===== 装饰横幅 ===== */
.promo-banner {
  width: 100%;
  height: 192rpx;
  border-radius: var(--radius-md);
  margin-top: 48rpx;
  background: linear-gradient(to right, rgba(236, 55, 19, 0.9), rgba(236, 55, 19, 0.7));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.promo-banner__content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.promo-banner__tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.promo-banner__title {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.promo-banner__arrow {
  font-size: 40rpx;
  color: #fff;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  height: 96rpx;
  background: #ec3713;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: var(--shadow-primary-lg);
}

.btn-secondary {
  height: 96rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4b5563;
}
