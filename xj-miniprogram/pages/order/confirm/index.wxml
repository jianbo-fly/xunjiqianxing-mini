<view class="page-order-confirm">
  <!-- 自定义导航栏（Figma: bg rgba(248,246,246,0.8) + 磨砂 + 底部边框） -->
  <nav-bar
    title="确认订单"
    background="rgba(248, 246, 246, 0.92)"
    border
    showBack
    fixed
  />

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}" style="height: {{scrollHeight}}px;">
    <xj-loading text="加载中..." vertical />
  </view>

  <!-- 主内容 -->
  <scroll-view class="main-scroll" scroll-y wx:if="{{!loading}}" style="height: {{scrollHeight}}px;">
    <view class="main-content">

      <!-- 1. 产品卡片 -->
      <view class="card product-card">
        <!-- 图文信息 -->
        <view class="product-media">
          <view class="product-img-wrap">
            <image
              class="product-img"
              src="{{route.coverImage || (route.images && route.images[0]) || ''}}"
              mode="aspectFill"
            />
          </view>
          <view class="product-info">
            <view class="product-title">{{route.name}}</view>
            <view class="product-tags">
              <view class="product-tag" wx:if="{{route.duration || packageInfo.days}}">
                {{route.duration || packageInfo.days}}天{{(route.duration || packageInfo.days) - 1}}晚
              </view>
              <view class="product-tag" wx:if="{{packageInfo.name}}">{{packageInfo.name}}</view>
            </view>
          </view>
        </view>
        <!-- 出发信息行 -->
        <view class="product-footer">
          <view class="departure-info">
            <xj-icon name="calendar" size="28" color="#EC3713" wx:if="{{false}}" />
            <image class="departure-icon" src="/assets/icons/common/departure-icon.png" mode="aspectFit" /> 
            <text class="departure-date">{{date}} 出发</text>
          </view>
          <text class="people-count">x {{totalPeople}} 人</text>
        </view>
      </view>

      <!-- 2. 出行人信息 -->
      <view class="card travelers-card">
        <!-- 区块标题 -->
        <view class="card-header">
          <view class="card-header__left">
            <text class="card-title">出行人信息</text>
            <text class="card-title-sub"> ({{filledPeople}}/{{totalPeople}})</text>
          </view>
          <view class="realname-badge">需实名认证</view>
        </view>

        <!-- 出行人列表 -->
        <view class="traveler-list">
          <!-- 成人 -->
          <view
            class="traveler-item {{item ? '' : 'traveler-item--empty'}}"
            wx:for="{{adultTravelers}}"
            wx:key="index"
          >
            <block wx:if="{{item}}">
              <view class="traveler-info">
                <view class="traveler-name-row">
                  <text class="traveler-name">{{item.name}}</text>
                  <view class="type-badge">成人</view>
                </view>
                <text class="traveler-id">身份证 {{item.idNoMask || item.idNo}}</text>
              </view>
              <view class="traveler-edit-btn" data-type="adult" data-index="{{index}}" bindtap="handleShowTravelerPopup">
                <image class="traveler-edit-icon" src="/assets/icons/common/edit-traveler.png" mode="aspectFit" />  
              </view>
            </block>
            <block wx:else>
              <view class="traveler-empty-row" data-type="adult" data-index="{{index}}" bindtap="handleShowTravelerPopup">
                <text class="empty-icon">+</text>
                <text class="empty-text">添加成人 {{index + 1}}</text>
              </view>
            </block>
          </view>

          <!-- 儿童 -->
          <view
            class="traveler-item {{item ? '' : 'traveler-item--empty'}}"
            wx:for="{{childTravelers}}"
            wx:key="index"
          >
            <block wx:if="{{item}}">
              <view class="traveler-info">
                <view class="traveler-name-row">
                  <text class="traveler-name">{{item.name}}</text>
                  <view class="type-badge">儿童</view>
                </view>
                <text class="traveler-id">身份证 {{item.idNoMask || item.idNo}}</text>
              </view>
              <view class="traveler-edit-btn" data-type="child" data-index="{{index}}" bindtap="handleShowTravelerPopup">
                <image class="traveler-edit-icon" src="/assets/icons/common/more.png" mode="aspectFit" />
              </view>
            </block>
            <block wx:else>
              <view class="traveler-empty-row" data-type="child" data-index="{{index}}" bindtap="handleShowTravelerPopup">
                <text class="empty-icon">+</text>
                <text class="empty-text">添加儿童 {{index + 1}}</text>
              </view>
            </block>
          </view>
        </view>

        <!-- 添加出行人按钮 -->
        <view class="add-traveler-btn" bindtap="handleShowAddTraveler">
          <text class="add-traveler-icon">⊕</text>
          <text class="add-traveler-text">添加出行人</text>
        </view>
      </view>

      <!-- 3. 联系方式 -->
      <view class="card contact-card">
        <text class="card-title">联系方式</text>
        <view class="contact-rows">
          <view class="contact-row">
            <text class="contact-label">联系人</text>
            <input
              class="contact-input"
              value="{{contact.name}}"
              placeholder="请输入联系人姓名"
              placeholder-class="input-placeholder"
              data-field="name"
              bindinput="handleContactInput"
            />
          </view>
          <view class="contact-divider"></view>
          <view class="contact-row">
            <text class="contact-label">手机号</text>
            <view class="phone-input-wrap">
              <text class="phone-prefix">+86</text>
              <input
                class="contact-input"
                type="number"
                maxlength="11"
                value="{{contact.phone}}"
                placeholder="请输入手机号"
                placeholder-class="input-placeholder"
                data-field="phone"
                bindinput="handleContactInput"
              />
            </view>
          </view>
        </view>
      </view>

      <!-- 4. 优惠券 & 意外险 -->
      <view class="card discount-card">
        <!-- 优惠券行 -->
        <view class="coupon-row" bindtap="handleShowCouponPopup">
          <view class="coupon-row__left">
            <text class="coupon-label">优惠券</text>
            <view class="coupon-recommend-tag">推荐</view>
          </view>
          <view class="coupon-row__right">
            <text class="coupon-saving" wx:if="{{couponDiscount > 0}}">已省 ¥{{couponDiscount}}</text>
            <text class="coupon-count" wx:elif="{{coupons.length > 0}}">{{coupons.length}}张可用</text>
            <text class="coupon-none" wx:else>暂无</text>
            <image class="row-arrow" src="/assets/icons/common/arrow-right.png" mode="aspectFit" />
          </view>
        </view>
        <view class="discount-divider"></view>
        <!-- 意外险行 -->
        <view class="insurance-row">
          <view class="insurance-info">
            <text class="insurance-label">意外险</text>
            <text class="insurance-desc">含高原反应保障</text>
          </view>
          <view class="insurance-right">
            <text class="insurance-price">¥50/人</text>
            <view
              class="insurance-toggle {{insuranceSelected ? 'insurance-toggle--on' : ''}}"
              bindtap="handleToggleInsurance"
            >
              <text class="insurance-toggle-icon" wx:if="{{insuranceSelected}}">✓</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 5. 退改政策提示 -->
      <view class="policy-notice">
        <text class="policy-icon">ℹ</text>
        <view class="policy-text">
          <text>订单提交即视为同意 </text>
          <text class="policy-link">《退改规则》</text>
          <text> 及 </text>
          <text class="policy-link">《服务协议》</text>
          <text>。出发前7天可免费取消。</text>
        </view>
      </view>

    </view>
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{!loading}}">
    <view class="action-bar__price" bindtap="handleTogglePriceDetail">
      <view class="price-main">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{payAmount}}</text>
      </view>
      <view class="price-meta">
        <text class="price-detail-label">明细</text>
        <text class="price-detail-arrow">{{showPriceDetail ? '▾' : '▴'}}</text>
        <view class="price-saving-chip" wx:if="{{couponDiscount > 0}}">
          <text>已省 ¥{{couponDiscount}}</text>
        </view>
      </view>
    </view>
    <view
      class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}"
      bindtap="handleSubmit"
    >
      <text class="submit-btn__text">{{submitting ? '提交中...' : '提交订单'}}</text>
    </view>
  </view>

  <!-- 价格明细浮层 -->
  <view class="price-detail-panel" wx:if="{{showPriceDetail}}" bindtap="handleTogglePriceDetail">
    <view class="price-detail-panel__inner" catchtap="noop">
      <view class="price-detail-row" wx:if="{{adultCount > 0}}">
        <text class="pd-label">成人 x{{adultCount}}</text>
        <text class="pd-value">¥{{adultAmount}}</text>
      </view>
      <view class="price-detail-row" wx:if="{{childCount > 0}}">
        <text class="pd-label">儿童 x{{childCount}}</text>
        <text class="pd-value">¥{{childAmount}}</text>
      </view>
      <view class="price-detail-row" wx:if="{{couponDiscount > 0}}">
        <text class="pd-label">优惠券</text>
        <text class="pd-value pd-value--discount">-¥{{couponDiscount}}</text>
      </view>
      <view class="price-detail-divider"></view>
      <view class="price-detail-row price-detail-row--total">
        <text class="pd-label">合计</text>
        <text class="pd-value pd-value--total">¥{{payAmount}}</text>
      </view>
    </view>
  </view>

  <!-- 出行人选择弹窗 -->
  <xj-popup
    visible="{{showTravelerPopup}}"
    title="选择出行人"
    closable
    bind:close="handleCloseTravelerPopup"
    customClass="popup--scroll-footer"
  >
    <scroll-view class="popup-scroll" scroll-y>
      <view
        class="traveler-option"
        wx:for="{{travelerList}}"
        wx:key="id"
        data-traveler="{{item}}"
        bindtap="handleSelectTraveler"
      >
        <view class="option-info">
          <view class="option-name">{{item.name}}</view>
          <view class="option-detail">{{item.idTypeName || '身份证'}} | {{item.phone}}</view>
        </view>
        <view class="option-check" wx:if="{{item.isDefault}}">默认</view>
      </view>
      <view class="empty-list" wx:if="{{!travelerList.length}}">
        <text>暂无常用出行人</text>
      </view>
    </scroll-view>
    <view class="popup-footer">
      <xj-button type="primary" size="lg" block bind:tap="handleShowAddTraveler">+ 新增出行人</xj-button>
    </view>
  </xj-popup>

  <!-- 优惠券选择弹窗 -->
  <xj-popup
    visible="{{showCouponPopup}}"
    title="选择优惠券"
    closable
    bind:close="handleCloseCouponPopup"
    customClass="popup--scroll-footer"
  >
    <scroll-view class="popup-scroll" scroll-y>
      <view
        class="coupon-item {{selectedCoupon && selectedCoupon.id === item.id ? 'coupon-item--active' : ''}}"
        wx:for="{{coupons}}"
        wx:key="id"
        data-coupon="{{item}}"
        bindtap="handleSelectCoupon"
      >
        <view class="coupon-left">
          <text class="coupon-amount">¥{{item.discount}}</text>
          <text class="coupon-condition">满{{item.minAmount}}可用</text>
        </view>
        <view class="coupon-right">
          <view class="coupon-name">{{item.name}}</view>
          <view class="coupon-expire">{{item.expireTime}}到期</view>
        </view>
      </view>
      <view class="empty-list" wx:if="{{!coupons.length}}">
        <text>暂无可用优惠券</text>
      </view>
    </scroll-view>
    <view class="popup-footer">
      <view class="no-coupon-btn" bindtap="handleNoCoupon">
        <text>不使用优惠券</text>
      </view>
    </view>
  </xj-popup>
</view>
<xj-toast id="xj-toast"/>
