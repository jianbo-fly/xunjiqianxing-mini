.page-order-confirm {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 加载中（高度由 inline style 动态传入） */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 主滚动区（高度由 inline style 动态传入） */
.main-scroll {
  /* height 由 JS 计算后通过 inline style 传入 */
}

/* 主内容容器 */
.main-content {
  padding: var(--page-padding);
  padding-top: var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* 通用卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--card-padding);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

/* ===== 卡片通用标题 ===== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.card-header__left {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.card-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.card-title-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-normal);
}

/* ===== 1. 产品卡片 ===== */
.product-media {
  display: flex;
  gap: var(--spacing-md);
  align-items: flex-start;
}

.product-img-wrap {
  flex-shrink: 0;
  width: 192rpx;
  height: 192rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-border);
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-info {
  flex: 1;
  padding-top: 4rpx;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.product-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.4;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.product-tag {
  padding: 6rpx 18rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border-light);
}

.departure-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.departure-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.departure-date {
  font-size: var(--font-size-sm);
  color: var(--color-text-body);
}

.people-count {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

/* ===== 2. 出行人信息 ===== */
.realname-badge {
  padding: 8rpx 16rpx;
  background: var(--color-primary-tint);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.traveler-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.traveler-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx;
  background: var(--color-bg-page);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-sm);
}

.traveler-item--empty {
  background: transparent;
  border: 1rpx dashed var(--color-border);
}

.traveler-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.traveler-name-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.traveler-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.type-badge {
  padding: 4rpx 12rpx;
  background: var(--color-border);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-body);
  font-weight: var(--font-weight-medium);
}

.traveler-id {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.traveler-edit-btn {
  padding: var(--spacing-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.traveler-edit-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.4;
}

.traveler-empty-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  gap: var(--spacing-xs);
  padding: 8rpx 0;
}

.empty-icon {
  font-size: var(--font-size-xl);
  color: var(--color-primary);
}

.empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

/* 添加出行人按钮（虚线） */
.add-traveler-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  padding: 26rpx;
  border: 2rpx dashed var(--color-primary-border);
  border-radius: var(--radius-sm);
}

.add-traveler-icon {
  font-size: var(--font-size-xl);
  color: var(--color-primary);
}

.add-traveler-text {
  font-size: var(--font-size-lg);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* ===== 3. 联系方式 ===== */
.contact-card .card-title {
  display: block;
  margin-bottom: var(--spacing-md);
}

.contact-rows {
  display: flex;
  flex-direction: column;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
}

.contact-label {
  width: 128rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.phone-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.phone-prefix {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.contact-input {
  flex: 1;
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  min-height: 48rpx;
}

.input-placeholder {
  color: var(--color-text-placeholder);
}

.contact-divider {
  height: 2rpx;
  background: var(--color-border-light);
}

/* ===== 4. 优惠券 & 意外险 ===== */
.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}

.coupon-row__left {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.coupon-label {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.coupon-recommend-tag {
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-xs);
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.coupon-row__right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-saving {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.coupon-count {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

.coupon-none {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.row-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.35;
}

.discount-divider {
  height: 2rpx;
  background: var(--color-border-light);
  margin: var(--spacing-md) 0;
}

.insurance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.insurance-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.insurance-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.insurance-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.insurance-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.insurance-price {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.insurance-toggle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border-medium);
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.insurance-toggle--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.insurance-toggle-icon {
  font-size: 22rpx;
  color: var(--color-text-inverse);
  font-weight: var(--font-weight-bold);
}

/* ===== 5. 退改政策提示 ===== */
.policy-notice {
  display: flex;
  gap: var(--spacing-xs);
  align-items: flex-start;
  padding: 0 4rpx;
}

.policy-icon {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.policy-text {
  flex: 1;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.policy-link {
  color: var(--color-primary);
}

/* ===== 底部占位（按操作栏高度 + safe area 预留） ===== */
.bottom-placeholder {
  height: 180rpx;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: 24rpx var(--page-padding);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 2rpx solid var(--color-border-light);
  box-shadow: var(--shadow-inset-bottom);
  z-index: 100;
}

.action-bar__price {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-symbol {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.price-value {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  line-height: 1.1;
}

.price-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.price-detail-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.price-detail-arrow {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.price-saving-chip {
  padding: 4rpx 8rpx;
  background: var(--color-primary-tint);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

/* 提交按钮（胶囊形，对齐 Figma：py-[14px] px-[32px]） */
.submit-btn {
  padding: 28rpx 64rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary-lg);
  flex-shrink: 0;
}

.submit-btn--disabled {
  opacity: 0.6;
}

.submit-btn__text {
  color: var(--color-text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  white-space: nowrap;
}

/* ===== 价格明细浮层 ===== */
.price-detail-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
}

.price-detail-panel__inner {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg) var(--page-padding);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-inset-top);
}

.price-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.price-detail-row--total {
  padding-top: var(--spacing-md);
}

.pd-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.pd-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.pd-value--discount {
  color: var(--color-error);
}

.pd-value--total {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.price-detail-divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: var(--spacing-xs) 0;
}

/* ===== xj-popup 布局覆盖 ===== */
.popup--scroll-footer .xj-popup__container {
  max-height: 70vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup--scroll-footer .xj-popup__body {
  padding: 0;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-scroll {
  flex: 1;
  padding: var(--spacing-md) var(--page-padding);
  overflow-y: auto;
}

.popup-footer {
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}

/* ===== 出行人选项 ===== */
.traveler-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
}

.option-info {
  flex: 1;
}

.option-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.option-detail {
  margin-top: 4rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.option-check {
  padding: 4rpx 12rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  border-radius: var(--radius-xs);
}

/* ===== 优惠券弹窗 ===== */
.coupon-item {
  display: flex;
  margin-bottom: var(--spacing-sm);
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2rpx solid transparent;
}

.coupon-item--active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.coupon-left {
  width: 180rpx;
  padding: var(--spacing-md);
  background: linear-gradient(135deg, var(--color-error), #ff7875);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.coupon-amount {
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-inverse);
}

.coupon-condition {
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.coupon-right {
  flex: 1;
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-name {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.coupon-expire {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.no-coupon-btn {
  width: 100%;
  height: 88rpx;
  background: var(--color-bg-gray);
  color: var(--color-text-secondary);
  font-size: var(--font-size-md);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空列表 */
.empty-list {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}
