/**
 * 订单详情页样式 - 对齐 Figma 5-4
 */

.page-order-detail {
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* 加载（高度由 inline style 动态传入） */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 主滚动（高度由 JS 计算后通过 inline style 传入） */
.main-scroll {}

/* 主内容 */
.main-content {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 状态横幅 ===== */
.status-banner {
  border-radius: var(--radius-md);
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.status-banner__deco {
  position: absolute;
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(24rpx);
  right: -32rpx;
  top: -32rpx;
  pointer-events: none;
}

.status-banner--orange {
  background: var(--color-primary);
  box-shadow: var(--shadow-primary-lg);
}

.status-banner--primary {
  background: var(--color-primary-gradient);
  box-shadow: var(--shadow-primary-lg);
}

.status-banner--green {
  background: var(--color-success-gradient);
  box-shadow: 0 20rpx 30rpx -6rpx rgba(16, 185, 129, 0.2);
}

.status-banner--gray {
  background: var(--color-cancelled-gradient);
}

.status-banner--blue {
  background: var(--color-info-gradient);
  box-shadow: 0 20rpx 30rpx -6rpx rgba(59, 130, 246, 0.2);
}

.status-banner__row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
}

.status-banner__icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.status-banner__content {
  flex: 1;
}

.status-banner__title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  line-height: 56rpx;
}

.status-banner__subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 40rpx;
  margin-top: 4rpx;
}

.status-countdown {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  position: relative;
}

.status-countdown__time {
  font-weight: 600;
  color: var(--color-text-inverse);
}

/* ===== 通用卡片 ===== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
  padding: 34rpx;
}

/* ===== 区块标题（红竖条 + 文字） ===== */
.section-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-hd__bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  flex-shrink: 0;
}

.section-hd__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* ===== 路线卡片 ===== */
.route-card {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}

.route-img {
  width: 192rpx;
  height: 192rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--color-border);
}

.route-info {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.route-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.route-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.route-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-meta-icon {
  width: 24rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.route-meta-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 出行人 ===== */
.traveler-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 26rpx;
  margin-bottom: 24rpx;
}

.traveler-item--border {
  border-bottom: 1rpx solid var(--color-bg-gray);
}

.traveler-item:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
}

.traveler-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.traveler-avatar--adult {
  background: var(--color-primary-ultralight);
  color: var(--color-primary);
}

.traveler-avatar--child {
  background: var(--color-info-light);
  color: var(--color-info);
}

.traveler-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.traveler-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.traveler-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-strong);
}

.type-badge {
  padding: 3rpx 12rpx;
  border-radius: var(--radius-xs);
  font-size: 24rpx;
}

.type-badge--adult {
  background: var(--color-border-light);
  color: var(--color-text-secondary);
}

.type-badge--child {
  background: var(--color-info-light);
  color: var(--color-info);
}

.traveler-id {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ===== 键值对行（联系人） ===== */
.kv-rows {
  display: flex;
  flex-direction: column;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.kv-row:first-child {
  padding-top: 0;
}

.kv-row:last-child {
  padding-bottom: 0;
}

.kv-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.kv-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* ===== 费用明细 ===== */
.price-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.price-val {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.price-val--discount {
  color: var(--color-primary);
}

.price-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 26rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.price-total-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.price-total-val {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ===== 订单信息 - 复制按钮 ===== */
.order-no-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}

.order-no-text {
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-btn {
  padding: 6rpx 16rpx;
  background: var(--color-primary-bg);
  border: 1rpx solid var(--color-primary-tint);
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.copy-btn__text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* ===== 商家信息 ===== */
.merchant-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.merchant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.merchant-avatar__text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.merchant-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.merchant-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.merchant-call {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.merchant-call__text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
  font-weight: 500;
}

/* ===== 底部占位 ===== */
.bottom-placeholder {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-inset-top);
  padding: 26rpx 32rpx;
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.bottom-bar__btns {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.bbar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.bbar-btn__text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-body);
}

.bbar-btn--primary {
  background: var(--color-primary-gradient);
  border-color: transparent;
}

.bbar-btn--primary .bbar-btn__text {
  color: var(--color-text-inverse);
}
