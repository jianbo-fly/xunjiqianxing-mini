<view class="page-route-detail">
  <!-- 顶部导航（透明 → 不透明渐变） -->
  <view class="nav-header {{navOpaque ? 'nav-header--opaque' : ''}}" style="padding-top: {{statusBarHeight}}px; height: {{navBarBottom}}px;">
    <view class="nav-btn {{navOpaque ? 'nav-btn--opaque' : ''}} nav-btn--back" bindtap="handleBack">
      <image class="nav-back-icon" src="/assets/icons/common/arrow-left.png" mode="aspectFit" />
    </view>
    <text class="nav-title" wx:if="{{navOpaque && route}}">{{route.name}}</text>
    <view class="nav-btn {{navOpaque ? 'nav-btn--opaque' : ''}} nav-btn--share" bindtap="onShareAppMessage">
      <image src="/assets/icons/common/share.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <xj-loading text="加载中..." vertical />
  </view>

  <!-- 吸顶 tabs + Day nav（滚动到 content-section 后才显示） -->
  <view class="sticky-tabs-header" wx:if="{{showStickyHeader}}" style="top: {{navBarBottom}}px;">
    <!-- 内容 Tab -->
    <view class="sth-tabs">
      <view
        wx:for="{{contentTabs}}"
        wx:key="index"
        class="sth-tab {{contentTab === index ? 'sth-tab--active' : ''}}"
        data-index="{{index}}"
        bindtap="handleContentTabChange"
      >
        <text>{{item}}</text>
        <view class="sth-tab__line" wx:if="{{contentTab === index}}"></view>
      </view>
    </view>
    <!-- Day nav（仅行程介绍 tab） -->
    <scroll-view
      wx:if="{{contentTab === 0 && route.itinerary && route.itinerary.length}}"
      class="day-nav-scroll"
      scroll-x
      enable-flex
      scroll-left="{{dayNavScrollLeft}}"
      scroll-with-animation
    >
      <view class="day-nav-list">
        <view
          wx:for="{{route.itinerary}}"
          wx:key="index"
          class="day-nav-item {{itineraryNavIndex === index ? 'day-nav-item--active' : ''}}"
          data-index="{{index}}"
          bindtap="handleItineraryNavTap"
        >D{{item.day || index + 1}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 主内容 -->
  <scroll-view class="main-scroll" scroll-y scroll-into-view="{{itineraryScrollIntoView}}" bindscroll="handleMainScroll" wx:if="{{!loading && route}}">
    <!-- 图片轮播 -->
    <view class="banner-section">
      <swiper
        class="banner-swiper"
        autoplay
        circular
        bindchange="handleSwiperChange"
      >
        <swiper-item
          wx:for="{{bannerImages}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="handlePreviewImage"
        >
          <image class="banner-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
      <!-- 底部渐变遮罩 -->
      <view class="banner-gradient"></view>
      <!-- 图片计数 -->
      <view class="banner-indicator">{{swiperIndex + 1}}/{{bannerImages.length}}</view>
      <!-- 分页圆点 -->
      <view class="banner-dots" wx:if="{{bannerImages.length > 1}}">
        <view
          wx:for="{{bannerImages}}"
          wx:key="index"
          class="banner-dot {{swiperIndex === index ? 'banner-dot--active' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 基本信息卡片（与 Hero 重叠） -->
    <view class="info-card">
      <!-- 标题行 -->
      <view class="info-card__top">
        <view class="info-card__title-wrap">
          <view class="route-name">{{route.name}}</view>
          <view class="route-subtitle" wx:if="{{route.subtitle}}">{{route.subtitle}}</view>
        </view>
        <!-- 出发地/天数标签 -->
        <view class="info-card__meta-tags">
          <view class="info-meta-tag" wx:if="{{route.departureCity}}">
            <text class="info-meta-tag__text">{{route.departureCity}}</text>
          </view>
          <view class="info-meta-tag" wx:if="{{route.days}}">
            <text class="info-meta-tag__text">{{route.days}}天</text>
          </view>
        </view>
      </view>

      <!-- 价格行 -->
      <view class="route-price">
        <view class="price-main">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{selectedPrice || route.minPrice}}</text>
          <text class="price-unit">/人起</text>
        </view>
        <view class="route-meta">
          <view class="route-rating" wx:if="{{route.score}}">
            <text class="rating-star">★</text>
            <text class="rating-value">{{route.score}}</text>
          </view>
          <text class="route-sales" wx:if="{{route.salesCount}}"> 已售{{route.salesCount}}人</text>
        </view>
      </view>

      <!-- 保障标签行 -->
      <view class="guarantee-tags">
        <view class="guarantee-tag">
          <text class="guarantee-tag__icon">✓</text>
          <text class="guarantee-tag__text">品质保障</text>
        </view>
        <view class="guarantee-tag">
          <text class="guarantee-tag__icon">✓</text>
          <text class="guarantee-tag__text">极速退款</text>
        </view>
        <view class="guarantee-tag">
          <text class="guarantee-tag__icon">✓</text>
          <text class="guarantee-tag__text">成团保障</text>
        </view>
      </view>

      <!-- 特色标签 -->
      <view class="route-tags" wx:if="{{route.tags && route.tags.length}}">
        <view class="route-tag" wx:for="{{route.tags}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <!-- 行程亮点 -->
    <view class="highlight-section" wx:if="{{route.highlights && route.highlights.length}}">
      <view class="section-title">行程亮点</view>
      <view class="highlight-list">
        <view class="highlight-item" wx:for="{{route.highlights}}" wx:key="index">
          <text class="highlight-icon">✓</text>
          <text class="highlight-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 预订卡片（套餐 + 日期 + 人数合并） -->
    <view class="booking-card">
      <!-- 套餐选择 -->
      <view wx:if="{{packages && packages.length}}">
        <view class="section-header-row booking-card__header">
          <text class="section-title">套餐选择</text>
        </view>
        <scroll-view class="package-scroll" scroll-x enable-flex>
          <view class="package-cards">
            <view
              wx:for="{{packages}}"
              wx:key="id"
              class="package-card {{selectedPackage && selectedPackage.id === item.id ? 'package-card--active' : ''}}"
              data-index="{{index}}"
              bindtap="handlePackageSelect"
            >
              <text class="package-card__name">{{item.name}}</text>
              <text class="package-card__desc" wx:if="{{item.description}}">{{item.description}}</text>
              <text class="package-card__price">¥{{item.basePrice}}<text class="package-card__unit">/人</text></text>
              <view class="package-card__check" wx:if="{{selectedPackage && selectedPackage.id === item.id}}">✓</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 日期选择条 -->
      <view class="booking-card__date-wrap" wx:if="{{calendar && calendar.length}}">
        <view class="section-header-row booking-card__header">
          <text class="section-title">出行日期</text>
          <text class="section-more" bindtap="handleShowCalendar">更多日期 ›</text>
        </view>
        <scroll-view class="date-strip-scroll" scroll-x enable-flex scroll-left="{{dateStripScrollLeft}}" scroll-with-animation>
          <view class="date-strip-list">
            <view
              wx:for="{{calendar}}"
              wx:key="date"
              class="date-strip-item {{selectedDate === item.date ? 'date-strip-item--active' : ''}} {{item.stock <= 0 ? 'date-strip-item--disabled' : ''}}"
              data-item="{{item}}"
              bindtap="handleDateSelect"
            >
              <text class="date-strip-item__week">{{item.week}}</text>
              <text class="date-strip-item__day">{{item.day}}</text>
              <text class="date-strip-item__price" wx:if="{{item.stock > 0}}">¥{{item.price}}</text>
              <text class="date-strip-item__sold" wx:else>售罄</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 备用入口（无套餐/日期数据时） -->
      <view wx:if="{{(!packages || !packages.length) && (!calendar || !calendar.length)}}">
        <view class="select-item" bindtap="handleShowPackage">
          <text class="select-label">套餐</text>
          <view class="select-value">
            <text>{{selectedPackage ? selectedPackage.name : '请选择套餐'}}</text>
            <text class="select-arrow">›</text>
          </view>
        </view>
        <view class="select-item" bindtap="handleShowCalendar">
          <text class="select-label">日期</text>
          <view class="select-value">
            <text>{{selectedDate || '请选择出行日期'}}</text>
            <text class="select-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 虚线分隔 -->
      <view class="booking-card__divider"></view>

      <!-- 选择人数（始终显示） -->
      <view class="booking-card__people">
        <view class="section-header-row booking-card__header">
          <text class="section-title">选择人数</text>
        </view>

        <!-- 成人 -->
        <view class="people-item">
          <text class="people-type">成人</text>
          <view class="quantity-picker">
            <view class="quantity-btn quantity-btn--minus {{adultCount <= 1 ? 'quantity-btn--disabled' : ''}}" bindtap="handleAdultMinus">-</view>
            <text class="quantity-value">{{adultCount}}</text>
            <view class="quantity-btn quantity-btn--plus" bindtap="handleAdultPlus">+</view>
          </view>
        </view>

        <!-- 儿童 -->
        <view class="people-item people-item--last">
          <view class="people-label-row">
            <text class="people-type">儿童</text>
            <text class="people-age">(2-12岁)</text>
          </view>
          <view class="quantity-picker">
            <view class="quantity-btn quantity-btn--minus {{childCount <= 0 ? 'quantity-btn--disabled' : ''}}" bindtap="handleChildMinus">-</view>
            <text class="quantity-value">{{childCount}}</text>
            <view class="quantity-btn quantity-btn--plus {{childCount >= adultCount ? 'quantity-btn--disabled' : ''}}" bindtap="handleChildPlus">+</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 内容区（tabs 已移到页面顶层 fixed，这里只放内容） -->
    <view class="content-section" id="content-section">

      <!-- 行程安排 -->
      <view class="content-panel content-panel--itin" wx:if="{{contentTab === 0}}">
        <block wx:if="{{route.itinerary && route.itinerary.length}}">
          <!-- 每天卡片 -->
          <view
            wx:for="{{route.itinerary}}"
            wx:key="index"
            class="itin-day-card"
            id="itin-day-{{index}}"
          >
            <!-- 卡片头 -->
            <view class="itin-day-header">
              <view class="itin-day-accent"></view>
              <view class="itin-day-num">Day {{item.day || index + 1}}</view>
              <view class="itin-day-title">{{item.title}}</view>
            </view>

            <!-- 活动时间轴 -->
            <view class="itin-timeline" wx:if="{{item.activities && item.activities.length}}">
              <view
                wx:for="{{item.activities}}"
                wx:for-item="act"
                wx:for-index="actIdx"
                wx:key="actIdx"
                class="itin-act"
              >
                <!-- 左侧时间轴 -->
                <view class="itin-act__left">
                  <view class="itin-act__dot"></view>
                  <view class="itin-act__line" wx:if="{{actIdx < item.activities.length - 1}}"></view>
                </view>
                <!-- 右侧内容 -->
                <view class="itin-act__body">
                  <view class="itin-act__meta">
                    <text class="itin-act__time" wx:if="{{act.time}}">{{act.time}}</text>
                    <text class="itin-act__text">{{act.content}}</text>
                  </view>
                  <!-- 图片区域：根据张数自动切换布局 -->
                  <view
                    wx:if="{{act.images && act.images.length}}"
                    class="itin-imgs itin-imgs--{{act.images.length === 1 ? 'single' : act.images.length === 2 ? 'double' : act.images.length === 3 ? 'triple' : 'grid'}}"
                  >
                    <image
                      wx:for="{{act.images}}"
                      wx:for-item="img"
                      wx:for-index="imgIdx"
                      wx:key="imgIdx"
                      class="itin-img"
                      src="{{img}}"
                      mode="aspectFill"
                      bindtap="handlePreviewActImage"
                      data-urls="{{act.images}}"
                      data-current="{{img}}"
                    />
                  </view>
                </view>
              </view>
            </view>

            <!-- 住宿信息 -->
            <view class="itin-hotel" wx:if="{{item.hotel}}">
              <text class="itin-hotel__icon">🏨</text>
              <text class="itin-hotel__text">{{item.hotel}}</text>
            </view>
          </view>
        </block>
        <view class="empty-content" wx:else>
          <text>暂无行程安排</text>
        </view>
      </view>

      <!-- 费用说明 -->
      <view class="content-panel" wx:if="{{contentTab === 1}}">
        <view class="fee-section" wx:if="{{route.costExclude}}">
          <view class="fee-title">费用不含</view>
          <view class="fee-content">
            <rich-text nodes="{{route.costExclude}}"></rich-text>
          </view>
        </view>
        <view class="fee-section" wx:if="{{route.tips}}">
          <view class="fee-title">温馨提示</view>
          <view class="fee-content">
            <rich-text nodes="{{route.tips}}"></rich-text>
          </view>
        </view>
        <view class="empty-content" wx:if="{{!route.costExclude && !route.tips}}">
          <text>暂无费用说明</text>
        </view>
      </view>

      <!-- 预订须知 -->
      <view class="content-panel" wx:if="{{contentTab === 2}}">
        <view class="notice-content" wx:if="{{route.bookingNotice}}">
          <rich-text nodes="{{route.bookingNotice}}"></rich-text>
        </view>
        <view class="notice-list" wx:elif="{{route.notices && route.notices.length}}">
          <view class="notice-item" wx:for="{{route.notices}}" wx:key="index">
            <text class="notice-num">{{index + 1}}.</text>
            <text>{{item}}</text>
          </view>
        </view>
        <view class="empty-content" wx:else>
          <text>暂无预订须知</text>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{!loading}}">
    <view class="action-bar__left">
      <view class="action-btn" bindtap="handleService">
        <image class="action-btn__icon" src="/assets/icons/common/service.png" mode="aspectFit" />
        <text class="action-btn__text">客服</text>
      </view>
      <view class="action-btn" bindtap="handleFavorite">
        <image class="action-btn__icon" src="/assets/icons/common/{{isFavorite ? 'favorite-active' : 'favorite'}}.png" mode="aspectFit" />
        <text class="action-btn__text">{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
    <view class="action-bar__right">
      <view class="book-btn" bindtap="handleBook">
        <view class="book-btn__price" wx:if="{{totalAmount}}">
          <text class="book-btn__price-label">总价</text>
          <text class="book-btn__price-value">¥{{totalAmount}}</text>
        </view>
        <view class="book-btn__sep" wx:if="{{totalAmount}}"></view>
        <text class="book-btn__text">立即预订</text>
      </view>
    </view>
  </view>

  <!-- 套餐选择弹窗 -->
  <xj-popup
    visible="{{showPackagePopup}}"
    title="选择套餐"
    closable
    bind:close="handleClosePackage"
    customClass="popup--scroll-footer"
  >
    <scroll-view class="popup-scroll" scroll-y>
      <view
        class="package-item {{selectedPackage && selectedPackage.id === item.id ? 'package-item--active' : ''}}"
        wx:for="{{packages}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="handlePackageSelect"
      >
        <view class="package-header">
          <view class="package-name">{{item.name}}</view>
          <view class="package-tags" wx:if="{{item.tags && item.tags.length}}">
            <text class="package-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
        <view class="package-attrs" wx:if="{{item.attrsDisplay && item.attrsDisplay.length}}">
          <text class="package-attr" wx:for="{{item.attrsDisplay}}" wx:for-item="attr" wx:key="*this">{{attr}}</text>
        </view>
        <view class="package-price">¥{{item.basePrice}}<text class="package-price-unit">/人</text></view>
      </view>
      <view class="empty-content" wx:if="{{!packages.length}}">
        <text>暂无可选套餐</text>
      </view>
    </scroll-view>
    <view class="popup-footer">
      <xj-button type="primary" size="lg" block bind:tap="handleClosePackage">确定</xj-button>
    </view>
  </xj-popup>

  <!-- 日期选择弹窗 -->
  <xj-popup
    visible="{{showCalendarPopup}}"
    title="选择出行日期"
    closable
    bind:close="handleCloseCalendar"
    customClass="popup--scroll-footer"
  >
    <!-- 固定星期表头 -->
    <view class="cal-weekday-header">
      <text class="cal-weekday-item" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text>
    </view>
    <!-- 月份瀑布流 -->
    <scroll-view
      class="cal-scroll"
      scroll-y
      bindscrolltolower="handleLoadMoreMonth"
      lower-threshold="120"
    >
      <block wx:for="{{calendarMonths}}" wx:key="label" wx:for-item="monthData">
        <view class="cal-month-label">{{monthData.label}}</view>
        <view class="cal-grid">
          <block wx:for="{{monthData.cells}}" wx:key="index" wx:for-item="cell" wx:for-index="ci">
            <!-- 空白占位格 -->
            <view wx:if="{{!cell}}" class="cal-cell cal-cell--empty"></view>
            <!-- 日期格子 -->
            <view
              wx:else
              class="cal-cell {{cell.isPast ? 'cal-cell--past' : ''}} {{cell.stock === 0 ? 'cal-cell--sold' : ''}} {{selectedDate === cell.date ? 'cal-cell--active' : ''}} {{cell.isWeekend && !cell.isPast ? 'cal-cell--weekend' : ''}}"
              data-item="{{cell}}"
              bindtap="handleDateSelect"
            >
              <text class="cal-cell__day">{{cell.dayNum}}</text>
              <view wx:if="{{cell.isToday}}" class="cal-cell__dot"></view>
              <text wx:if="{{cell.isRealtime}}" class="cal-cell__realtime">实时计价</text>
              <text wx:elif="{{cell.stock === 0}}" class="cal-cell__label cal-cell__label--sold">售罄</text>
              <text wx:elif="{{cell.price != null}}" class="cal-cell__price cal-cell__price--{{cell.priceLevel}}">¥{{cell.price}}</text>
            </view>
          </block>
        </view>
      </block>
      <view class="cal-footer-tip" wx:if="{{calendarLoadingMore}}">加载中...</view>
      <view class="cal-footer-tip" wx:elif="{{loadedMonthCount >= 12}}">已显示未来 12 个月</view>
    </scroll-view>
  </xj-popup>
</view>
<xj-toast id="xj-toast"/>
