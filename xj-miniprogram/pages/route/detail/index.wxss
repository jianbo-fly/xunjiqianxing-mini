.page-route-detail {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 顶部导航 */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 8px;
  padding-left: var(--page-padding);
  padding-right: var(--page-padding);
  box-sizing: border-box;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-btn--share image {
  width: 36rpx;
  height: 36rpx;
}

/* 导航栏不透明状态（滑过 banner 后） */
.nav-header--opaque {
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.nav-btn--opaque {
  background: var(--color-bg-gray);
}

/* 不透明状态下图标变黑（原图标为白色，专为透明背景设计） */
.nav-header--opaque .nav-back-icon,
.nav-header--opaque .nav-btn--share image {
  filter: brightness(0);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  padding: 0 var(--spacing-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/* 主滚动区 */
.main-scroll {
  height: 100vh;
}

/* 图片轮播 */
.banner-section {
  position: relative;
}

.banner-swiper {
  height: 576rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  pointer-events: none;
}

.banner-indicator {
  position: absolute;
  right: var(--page-padding);
  bottom: 80rpx;
  padding: 6rpx 20rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  color: var(--color-text-inverse);
}

.banner-dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 5;
}

.banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  transition: all 0.2s;
}

.banner-dot--active {
  width: 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-text-inverse);
}

/* 信息卡片（与 Hero 重叠 48rpx） */
.info-card {
  position: relative;
  margin-top: -48rpx;
  padding: 40rpx 40rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: 48rpx 48rpx var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-card);
  z-index: 5;
}

.info-card__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-card__title-wrap {
  flex: 1;
}

.route-name {
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.route-subtitle {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.info-card__meta-tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.info-meta-tag {
  padding: 8rpx 16rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.info-meta-tag__text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.route-price {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-symbol {
  font-size: var(--font-size-lg);
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.price-value {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.price-unit {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.route-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.route-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  color: var(--color-warning);
}

.rating-value {
  color: var(--color-warning);
  font-weight: var(--font-weight-semibold);
}

/* 保障标签行 */
.guarantee-tags {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.guarantee-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.guarantee-tag__icon {
  font-size: 22rpx;
  color: var(--color-success);
  font-weight: bold;
}

.guarantee-tag__text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-md);
}

.route-tag {
  padding: 6rpx 16rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  border-radius: var(--radius-xs);
}

/* 预订卡片（套餐 + 日期 + 人数合并） */
.booking-card {
  margin-top: var(--section-gap);
  padding: var(--spacing-lg) 0 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.booking-card__header {
  padding: 0 var(--page-padding);
  margin-bottom: var(--spacing-md);
}

.booking-card__date-wrap {
  margin-top: var(--spacing-lg);
}

.booking-card__divider {
  margin: var(--spacing-lg) var(--page-padding) 0;
  border-top: 2rpx dashed var(--color-border);
}

.booking-card__people {
  padding-top: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--page-padding);
  margin-bottom: var(--spacing-md);
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.package-scroll {
  white-space: nowrap;
}

.package-cards {
  display: flex;
  gap: 20rpx;
  padding: 8rpx var(--page-padding);
}

.package-card {
  flex-shrink: 0;
  width: 240rpx;
  padding: 24rpx 20rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.package-card--active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.package-card__name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  white-space: normal;
}

.package-card__desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  white-space: normal;
  line-height: 1.4;
}

.package-card__price {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-top: 4rpx;
}

.package-card__unit {
  font-size: var(--font-size-xs);
  font-weight: normal;
  color: var(--color-text-tertiary);
}

.package-card__check {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: bold;
}

/* 日期选择条 */
.date-strip-scroll {
  white-space: nowrap;
}

.date-strip-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx var(--page-padding);
}

.date-strip-item {
  flex-shrink: 0;
  width: 144rpx;
  padding: 18rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.date-strip-item--active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.date-strip-item--disabled {
  opacity: 0.5;
}

.date-strip-item__week {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.date-strip-item--active .date-strip-item__week {
  color: var(--color-primary);
}

.date-strip-item__day {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-strong);
  text-align: center;
}

.date-strip-item--active .date-strip-item__day {
  color: var(--color-primary);
}

.date-strip-item__price {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
  text-align: center;
}

.date-strip-item__sold {
  font-size: 24rpx;
  color: var(--color-text-disabled);
  text-align: center;
}

/* 行程亮点 */
.highlight-section {
  margin-top: var(--section-gap);
  padding: var(--spacing-lg) var(--page-padding);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.highlight-icon {
  color: var(--color-success);
  font-weight: bold;
}

.highlight-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 选择区域 */
.select-section {
  margin-top: var(--section-gap);
  background: var(--color-bg-card);
}

.select-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) var(--page-padding);
  border-bottom: 1rpx solid var(--color-border);
}

.select-item:last-child {
  border-bottom: none;
}

.select-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
}

.select-value {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.select-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
}

/* 数量选择器 */
.quantity-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

/* 减号：灰色边框 */
.quantity-btn--minus {
  border: 2rpx solid var(--color-border-medium);
  background: transparent;
  color: var(--color-text-primary);
}

/* 加号：浅橙背景 + 主色边框 */
.quantity-btn--plus {
  background: var(--color-primary-tint);
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.quantity-btn--disabled {
  opacity: 0.35;
}

.quantity-value {
  width: 48rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-strong);
}

/* 吸顶 fixed 头部（tabs + day nav） */
.sticky-tabs-header {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.sth-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
}

.sth-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  position: relative;
}

.sth-tab--active {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.sth-tab__line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* 内容区 */
.content-section {
  margin-top: var(--section-gap);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.content-panel {
  padding: var(--spacing-lg) var(--page-padding);
  min-height: 300rpx;
}

/* ===== 行程安排（新版） ===== */

.content-panel--itin {
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
}

/* Day 导航（在 fixed header 内，不需要 sticky） */
.day-nav-scroll {
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border-light);
  background: var(--color-bg-card);
}

.day-nav-list {
  display: flex;
  gap: 12rpx;
  padding: 16rpx var(--page-padding);
}

.day-nav-item {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  position: relative;
  gap: 4rpx;
}

.day-nav-item__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #52525b;
  opacity: 0.6;
  line-height: 1.2;
}

.day-nav-item__title {
  font-size: 20rpx;
  color: #71717a;
  opacity: 0.7;
  max-width: 100rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 1.2;
}

.day-nav-item--active {
  background: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(236, 55, 19, 0.25);
}

.day-nav-item--active .day-nav-item__label {
  color: #ffffff;
  opacity: 1;
}

.day-nav-item--active .day-nav-item__title {
  color: rgba(255, 255, 255, 0.85);
  opacity: 1;
}

/* 每日卡片 */
.itin-day-card {
  margin: var(--spacing-lg) var(--page-padding) 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.itin-day-card:last-child {
  margin-bottom: var(--spacing-lg);
}

/* 卡片头 */
.itin-day-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx var(--page-padding);
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.itin-day-accent {
  width: 8rpx;
  height: 40rpx;
  background: linear-gradient(to bottom, var(--color-primary), #EA580C);
  border-radius: 4rpx;
  flex-shrink: 0;
}

.itin-day-num {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  flex-shrink: 0;
}

.itin-day-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 时间轴容器 */
.itin-timeline {
  padding: 24rpx var(--page-padding);
}

.itin-act {
  display: flex;
  gap: 20rpx;
}

/* 左侧轴 */
.itin-act__left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 56rpx;
  padding-top: 4rpx;
}

.itin-act__dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.12);
}

.itin-act__dot--transport { background: #ec3713; }
.itin-act__dot--meal      { background: #f97316; }
.itin-act__dot--scenic    { background: #3b82f6; }
.itin-act__dot--hotel     { background: #a855f7; }

.itin-act__dot-icon {
  width: 28rpx;
  height: 28rpx;
}

.itin-act__line {
  flex: 1;
  width: 2rpx;
  min-height: 40rpx;
  background: #d4d4d8;
  margin-top: 8rpx;
  border-left: 2rpx dashed #d4d4d8;
}

/* 右侧内容 */
.itin-act__body {
  flex: 1;
  padding-bottom: 40rpx;
  padding-left: 24rpx;
  min-width: 0;
}

.itin-act:last-child .itin-act__body {
  padding-bottom: 0;
}

/* 时间行：时钟图标 + 时间文字 */
.itin-act__time-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.itin-act__clock {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.itin-act__time {
  font-size: 24rpx;
  font-weight: 600;
  color: #a1a1aa;
  flex-shrink: 0;
}

.itin-act__meta {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.itin-act__text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* 图片区域 */
.itin-imgs {
  margin-top: 16rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

/* 单张：满宽 4:3 */
.itin-imgs--single {
  width: 100%;
}

.itin-imgs--single .itin-img {
  width: 100%;
  height: 380rpx;
  display: block;
}

/* 两张：二等分 1:1 */
.itin-imgs--double {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
}

.itin-imgs--double .itin-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

/* 三张：左大右两小 */
.itin-imgs--triple {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 100rpx 100rpx;
  gap: 4rpx;
  height: 204rpx;
}

.itin-imgs--triple .itin-img:first-child {
  grid-row: 1 / 3;
  height: 204rpx;
  width: 100%;
  display: block;
}

.itin-imgs--triple .itin-img {
  width: 100%;
  height: 100rpx;
  display: block;
}

/* 四张+：3列网格 1:1 */
.itin-imgs--grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.itin-imgs--grid .itin-img {
  width: 100%;
  height: 160rpx;
  display: block;
}

/* 住宿信息 */
.itin-hotel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx var(--page-padding);
  background: rgba(168, 85, 247, 0.06);
  border-top: 1rpx solid var(--color-border-light);
}

.itin-hotel__icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #a855f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.itin-hotel__icon-img {
  width: 26rpx;
  height: 26rpx;
}

.itin-hotel__text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 费用说明 */
.fee-section {
  margin-bottom: var(--spacing-lg);
}

.fee-section:last-child {
  margin-bottom: 0;
}

.fee-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.fee-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.fee-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.fee-icon {
  color: var(--color-success);
  font-weight: bold;
}

.fee-item--exclude .fee-icon {
  color: var(--color-error);
}

/* 预订须知 */
.notice-content {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.notice-item {
  display: flex;
  gap: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.notice-num {
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.empty-content {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-bar__left {
  display: flex;
  gap: var(--spacing-lg);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-btn__icon {
  width: 44rpx;
  height: 44rpx;
}

.action-btn__text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.action-bar__right {
  flex: 1;
  margin-left: var(--spacing-lg);
}

.book-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(to right, #EC3713, #EA580C);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  box-shadow: 0 20rpx 30rpx -6rpx var(--color-primary-border), 0 8rpx 12rpx -8rpx var(--color-primary-border);
}

/* 价格在按钮内（有选中金额时） */
.book-btn__price {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-left: 32rpx;
  flex: 1;
}

.book-btn__price-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1;
}

.book-btn__price-value {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-inverse);
  line-height: 1.2;
}

/* 竖向分隔线 */
.book-btn__sep {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 24rpx;
  flex-shrink: 0;
}

.book-btn__text {
  color: var(--color-text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  /* 有价格时靠右留间距；无价格时居中 */
  padding: 0 32rpx;
}

/* xj-popup 布局覆盖 */
.popup--scroll-footer .xj-popup__container {
  max-height: 70vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup--scroll-footer .xj-popup__body {
  padding: 0;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-scroll {
  flex: 1;
  padding: var(--spacing-md) var(--page-padding);
  overflow-y: auto;
}

.popup-footer {
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}

/* 套餐选择 */
.package-item {
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
}

.package-item--active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.package-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.package-desc {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.package-price {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.package-price-unit {
  font-size: var(--font-size-xs);
  font-weight: normal;
  color: var(--color-text-tertiary);
}

.package-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.package-tags {
  display: flex;
  gap: var(--spacing-xs);
}

.package-tag {
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.package-attrs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.package-attr {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ===== 弹窗日历（瀑布流多月） ===== */

/* 固定星期表头 */
.cal-weekday-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 16rpx var(--page-padding) 8rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.cal-weekday-item {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
  padding: 8rpx 0;
}

/* 滚动容器 */
.cal-scroll {
  max-height: 55vh;
}

/* 月份标题 */
.cal-month-label {
  padding: 32rpx var(--page-padding) 16rpx;
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 7列格子容器 */
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  padding: 0 var(--page-padding) 8rpx;
}

/* 单格基础 */
.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 2rpx 10rpx;
  border-radius: 12rpx;
  min-height: 100rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.cal-cell--empty {
  min-height: 100rpx;
}

/* 过去日期 */
.cal-cell--past {
  opacity: 0.28;
}

/* 售罄 */
.cal-cell--sold {
  opacity: 0.4;
}

/* 选中 */
.cal-cell--active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

/* 周末日期数字颜色 */
.cal-cell--weekend .cal-cell__day {
  color: var(--color-warning);
}

/* 日期数字 */
.cal-cell__day {
  font-size: 30rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1;
}

.cal-cell--active .cal-cell__day {
  color: var(--color-primary);
}

/* 今日红点 */
.cal-cell__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-top: 4rpx;
}

/* 价格（默认红色） */
.cal-cell__price {
  font-size: 18rpx;
  color: var(--color-primary);
  margin-top: 4rpx;
  line-height: 1;
}

.cal-cell__price--low {
  color: #16A34A;
}

.cal-cell__price--high {
  color: #EA580C;
}

/* 实时计价 */
.cal-cell__realtime {
  font-size: 16rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
  line-height: 1.3;
  text-align: center;
}

/* 售罄标签 */
.cal-cell__label--sold {
  font-size: 18rpx;
  color: var(--color-text-disabled);
  margin-top: 4rpx;
}

/* 加载更多 / 结束提示 */
.cal-footer-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 选择人数区域 */
.people-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--page-padding);
  border-bottom: 1rpx solid var(--color-border-light);
}

.people-item--last {
  border-bottom: none;
}

.people-type {
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-body);
}

.people-label-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.people-age {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

