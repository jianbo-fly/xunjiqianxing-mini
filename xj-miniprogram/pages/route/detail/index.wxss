.page-route-detail {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 顶部导航 */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 10rpx;
  padding-left: var(--page-padding);
  padding-right: var(--page-padding);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-btn--share image {
  width: 36rpx;
  height: 36rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/* 主滚动区 */
.main-scroll {
  height: 100vh;
}

/* 图片轮播 */
.banner-section {
  position: relative;
}

.banner-swiper {
  height: 576rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  pointer-events: none;
}

.banner-indicator {
  position: absolute;
  right: var(--page-padding);
  bottom: 80rpx;
  padding: 6rpx 20rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  color: var(--color-text-inverse);
}

.banner-dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 5;
}

.banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  transition: all 0.2s;
}

.banner-dot--active {
  width: 24rpx;
  border-radius: var(--radius-full);
  background: var(--color-text-inverse);
}

/* 信息卡片（与 Hero 重叠 48rpx） */
.info-card {
  position: relative;
  margin-top: -48rpx;
  padding: 40rpx 40rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: 48rpx 48rpx var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-card);
  z-index: 5;
}

.info-card__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-card__title-wrap {
  flex: 1;
}

.route-name {
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.route-subtitle {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.info-card__meta-tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.info-meta-tag {
  padding: 8rpx 16rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.info-meta-tag__text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.route-price {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-main {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-symbol {
  font-size: var(--font-size-lg);
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.price-value {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.price-unit {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.route-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.route-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  color: var(--color-warning);
}

.rating-value {
  color: var(--color-warning);
  font-weight: var(--font-weight-semibold);
}

/* 保障标签行 */
.guarantee-tags {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.guarantee-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.guarantee-tag__icon {
  font-size: 22rpx;
  color: var(--color-success);
  font-weight: bold;
}

.guarantee-tag__text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-md);
}

.route-tag {
  padding: 6rpx 16rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  border-radius: var(--radius-xs);
}

/* 预订卡片（套餐 + 日期 + 人数合并） */
.booking-card {
  margin-top: var(--section-gap);
  padding: var(--spacing-lg) 0 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.booking-card__header {
  padding: 0 var(--page-padding);
  margin-bottom: var(--spacing-md);
}

.booking-card__date-wrap {
  margin-top: var(--spacing-lg);
}

.booking-card__divider {
  margin: var(--spacing-lg) var(--page-padding) 0;
  border-top: 2rpx dashed var(--color-border);
}

.booking-card__people {
  padding-top: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--page-padding);
  margin-bottom: var(--spacing-md);
}

.section-more {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.package-scroll {
  white-space: nowrap;
}

.package-cards {
  display: flex;
  gap: 20rpx;
  padding: 8rpx var(--page-padding);
}

.package-card {
  flex-shrink: 0;
  width: 240rpx;
  padding: 24rpx 20rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.package-card--active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.package-card__name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  white-space: normal;
}

.package-card__desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  white-space: normal;
  line-height: 1.4;
}

.package-card__price {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-top: 4rpx;
}

.package-card__unit {
  font-size: var(--font-size-xs);
  font-weight: normal;
  color: var(--color-text-tertiary);
}

.package-card__check {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: bold;
}

/* 日期选择条 */
.date-strip-scroll {
  white-space: nowrap;
}

.date-strip-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx var(--page-padding);
}

.date-strip-item {
  flex-shrink: 0;
  width: 144rpx;
  padding: 18rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.date-strip-item--active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.date-strip-item--disabled {
  opacity: 0.5;
}

.date-strip-item__week {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.date-strip-item--active .date-strip-item__week {
  color: var(--color-primary);
}

.date-strip-item__day {
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-strong);
  text-align: center;
}

.date-strip-item--active .date-strip-item__day {
  color: var(--color-primary);
}

.date-strip-item__price {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
  text-align: center;
}

.date-strip-item__sold {
  font-size: 24rpx;
  color: var(--color-text-disabled);
  text-align: center;
}

/* 行程亮点 */
.highlight-section {
  margin-top: var(--section-gap);
  padding: var(--spacing-lg) var(--page-padding);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.highlight-icon {
  color: var(--color-success);
  font-weight: bold;
}

.highlight-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 选择区域 */
.select-section {
  margin-top: var(--section-gap);
  background: var(--color-bg-card);
}

.select-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) var(--page-padding);
  border-bottom: 1rpx solid var(--color-border);
}

.select-item:last-child {
  border-bottom: none;
}

.select-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
}

.select-value {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.select-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
}

/* 数量选择器 */
.quantity-picker {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}

/* 减号：灰色边框 */
.quantity-btn--minus {
  border: 2rpx solid var(--color-border-medium);
  background: transparent;
  color: var(--color-text-primary);
}

/* 加号：浅橙背景 + 主色边框 */
.quantity-btn--plus {
  background: var(--color-primary-tint);
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.quantity-btn--disabled {
  opacity: 0.35;
}

.quantity-value {
  width: 48rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-strong);
}

/* 内容区 */
.content-section {
  margin-top: var(--section-gap);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.content-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
}

.content-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  position: relative;
}

.content-tab--active {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.content-tab__line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.content-panel {
  padding: var(--spacing-lg) var(--page-padding);
  min-height: 300rpx;
}

/* 行程安排 - 携程风格 */
.itinerary-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.itinerary-day-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.day-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-bg-card);
}

.day-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 48rpx;
  padding: 0 24rpx;
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.day-header .day-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 时间轴 */
.timeline {
  padding: var(--spacing-md);
  padding-left: var(--spacing-xl);
  position: relative;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 42rpx;
  top: var(--spacing-md);
  bottom: var(--spacing-md);
  width: 4rpx;
  background: var(--color-border-light);
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  position: relative;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.timeline-icon {
  width: 28rpx;
  height: 28rpx;
}

.timeline-content {
  flex: 1;
  padding-top: 8rpx;
}

.timeline-time {
  display: inline-block;
  margin-right: var(--spacing-sm);
  padding: 4rpx 12rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.timeline-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* 餐食住宿信息 */
.day-footer {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--color-bg-gray);
  border-top: 1rpx solid var(--color-border);
}

.day-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
}

.info-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 费用说明 */
.fee-section {
  margin-bottom: var(--spacing-lg);
}

.fee-section:last-child {
  margin-bottom: 0;
}

.fee-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.fee-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.fee-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.fee-icon {
  color: var(--color-success);
  font-weight: bold;
}

.fee-item--exclude .fee-icon {
  color: var(--color-error);
}

/* 预订须知 */
.notice-content {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.notice-item {
  display: flex;
  gap: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.notice-num {
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.empty-content {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200rpx;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}

/* 底部占位 */
.bottom-placeholder {
  height: 140rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-bar__left {
  display: flex;
  gap: var(--spacing-lg);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-btn__icon {
  width: 44rpx;
  height: 44rpx;
}

.action-btn__text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.action-bar__right {
  flex: 1;
  margin-left: var(--spacing-lg);
}

.book-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(to right, #EC3713, #EA580C);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  box-shadow: 0 20rpx 30rpx -6rpx var(--color-primary-border), 0 8rpx 12rpx -8rpx var(--color-primary-border);
}

/* 价格在按钮内（有选中金额时） */
.book-btn__price {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-left: 32rpx;
  flex: 1;
}

.book-btn__price-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1;
}

.book-btn__price-value {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-inverse);
  line-height: 1.2;
}

/* 竖向分隔线 */
.book-btn__sep {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 24rpx;
  flex-shrink: 0;
}

.book-btn__text {
  color: var(--color-text-inverse);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  /* 有价格时靠右留间距；无价格时居中 */
  padding: 0 32rpx;
}

/* xj-popup 布局覆盖 */
.popup--scroll-footer .xj-popup__container {
  max-height: 70vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup--scroll-footer .xj-popup__body {
  padding: 0;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-scroll {
  flex: 1;
  padding: var(--spacing-md) var(--page-padding);
  overflow-y: auto;
}

.popup-footer {
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}

/* 套餐选择 */
.package-item {
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
}

.package-item--active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}

.package-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.package-desc {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.package-price {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.package-price-unit {
  font-size: var(--font-size-xs);
  font-weight: normal;
  color: var(--color-text-tertiary);
}

.package-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.package-tags {
  display: flex;
  gap: var(--spacing-xs);
}

.package-tag {
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.package-attrs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.package-attr {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 日期选择 */
.calendar-month-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.month-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-gray);
  border-radius: 50%;
}

.month-btn text {
  font-size: 40rpx;
  color: var(--color-text-primary);
  line-height: 1;
}

.month-btn--disabled {
  opacity: 0.3;
}

.calendar-month-text {
  margin: 0 var(--spacing-lg);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.calendar-scroll {
  max-height: 50vh;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: var(--spacing-md) var(--page-padding);
}

.calendar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  background: var(--color-bg-gray);
  border-radius: var(--radius-md);
  border: 2rpx solid transparent;
  gap: 4rpx;
}

.calendar-item--active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.calendar-item--disabled {
  opacity: 0.5;
}

.calendar-item--weekend .calendar-week,
.calendar-item--weekend .calendar-date {
  color: var(--color-warning);
}

.calendar-week {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

.calendar-item--active .calendar-week {
  color: var(--color-primary);
}

.calendar-date {
  font-size: 32rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1.2;
}

.calendar-item--active .calendar-date {
  color: var(--color-primary);
}

.calendar-price {
  font-size: 20rpx;
  color: var(--color-primary);
  line-height: 1;
}

.calendar-sold {
  font-size: 20rpx;
  color: var(--color-text-disabled);
  line-height: 1;
}

/* 选择人数区域 */
.people-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--page-padding);
  border-bottom: 1rpx solid var(--color-border-light);
}

.people-item--last {
  border-bottom: none;
}

.people-type {
  font-size: 28rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-body);
}

.people-label-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.people-age {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

