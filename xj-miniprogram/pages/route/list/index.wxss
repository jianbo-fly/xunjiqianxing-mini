/**
 * 线路列表页样式
 * 顶部 Tabs/分类/筛选 样式已移至组件：components/business/route-list-header/index.wxss
 */

.page-route-list {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* ===== 搜索栏（固定在 nav-bar 下方） ===== */
.rl-search-bar {
  position: fixed;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 110;
  padding: 12rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

/* 搜索框（城市 + 关键词） */
.rl-search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #f3f4f6;
}

.rl-search-box__city {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-right: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}

.rl-search-box__city-icon {
  width: 24rpx;
  height: 30rpx;
  opacity: 0.7;
}

.rl-search-box__city-text {
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
}

.rl-search-box__city-arrow {
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 9rpx solid #9ca3af;
  margin-left: 2rpx;
}

.rl-search-box__input-area {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
  min-width: 0;
}

.rl-search-box__search-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

.rl-search-box__keyword {
  flex: 1;
  font-size: 26rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.rl-search-box__keyword--placeholder {
  color: #9ca3af;
}

.rl-search-box__clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d1d5db;
  border-radius: 50%;
  margin-left: 8rpx;
}

/* ===== 城市选择弹窗（与首页相同样式） ===== */
.city-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.city-picker-panel {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  height: 88vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.city-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}

.city-picker-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.city-picker-close {
  padding: 8rpx;
}

.city-picker-scroll {
  flex: 1;
  overflow: hidden;
  padding-right: 56rpx;
}

.city-section {
  padding: 28rpx 40rpx 8rpx;
}

.city-section-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.city-section-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.city-section-clear {
  font-size: 24rpx;
  color: #9ca3af;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.city-chip {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #374151;
}

.city-chip--active {
  background: #fff5f3;
  border-color: #ec3713;
  color: #ec3713;
  font-weight: 500;
}

.city-letter-header {
  padding: 12rpx 40rpx;
  background: #f9fafb;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.city-list-item {
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: #111827;
  border-bottom: 1rpx solid #f3f4f6;
}

.city-list-item--active {
  color: #ec3713;
  font-weight: 500;
}

.city-index-bar {
  position: absolute;
  right: 0;
  top: 120rpx;
  bottom: 0;
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 0;
}

.city-index-letter {
  font-size: 20rpx;
  color: #ec3713;
  line-height: 1.6;
  padding: 2rpx 8rpx;
}

/* ===== 筛选下拉面板 ===== */
.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 200;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 201;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.14);
  border-radius: 0 0 24rpx 24rpx;
  padding: 32rpx 32rpx 0;
}

.filter-panel__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

/* 城市网格：4列 */
.filter-panel__grid--departure {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

/* 天数/预算网格：3列 */
.filter-panel__grid--days,
.filter-panel__grid--budget {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.filter-chip {
  padding: 18rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.filter-chip--active {
  background: #feece9;
  border-color: #ec3713;
  color: #ec3713;
  font-weight: 600;
}

.filter-panel__footer {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0 32rpx;
  margin-top: 28rpx;
  border-top: 1rpx solid #f3f4f6;
}

.filter-panel__btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.filter-panel__btn--reset {
  border: 2rpx solid #d1d5db;
  color: #374151;
  background: #fff;
}

.filter-panel__btn--confirm {
  background: #ec3713;
  color: #fff;
  border: none;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

/* ===== 线路列表 ===== */
.route-list {
  padding: 24rpx var(--page-padding);
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.route-card-wrap {
  display: block;
}

/* ===== 新版路线卡片 ===== */
.list-route-card {
  background: var(--color-bg-card);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

/* 图片区 */
.list-route-card__image-wrap {
  position: relative;
  width: 100%;
  height: 384rpx;
}

.list-route-card__image {
  width: 100%;
  height: 100%;
}

.list-route-card__location-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-full);
}

.list-route-card__loc-icon {
  width: 20rpx;
  height: 24rpx;
  opacity: 0.9;
}

.list-route-card__loc-text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
}

.list-route-card__favorite {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.list-route-card__fav-icon {
  font-size: 32rpx;
  color: var(--color-primary);
}

/* 内容区 */
.list-route-card__content {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.list-route-card__tag {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: var(--font-weight-medium);
}

/* 第一个标签：主色描边样式（对齐 Figma） */
.list-route-card__tag--primary {
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-border);
  color: var(--color-primary);
}

.list-route-card__tag--orange {
  background: var(--tag-orange-bg);
  color: var(--tag-orange-text);
}

.list-route-card__tag--blue {
  background: var(--tag-blue-bg);
  color: var(--tag-blue-text);
}

.list-route-card__tag--green {
  background: var(--tag-green-bg);
  color: var(--tag-green-text);
}

.list-route-card__tag--purple {
  background: var(--tag-purple-bg);
  color: var(--tag-purple-text);
}

.list-route-card__title {
  font-size: 36rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-route-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.list-route-card__rating {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.list-route-card__divider {
  width: 2rpx;
  height: 24rpx;
  background: var(--color-border);
}

.list-route-card__sales {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.list-route-card__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.list-route-card__bottom-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.list-route-card__depart {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.list-route-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: var(--color-primary);
}

.list-route-card__price-symbol {
  font-size: 24rpx;
  font-weight: var(--font-weight-bold);
}

.list-route-card__price-value {
  font-size: 48rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.list-route-card__price-unit {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.list-route-card__cta {
  background: var(--color-primary);
  padding: 20rpx 32rpx;
  border-radius: var(--radius-md);
}

.list-route-card__cta-text {
  font-size: 28rpx;
  color: var(--color-text-inverse);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: var(--spacing-lg) 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}
