<!--
  线路列表页
-->
<view class="page-route-list">

  <nav-bar title="线路列表" background="rgba(248, 246, 246, 0.9)" border showBack fixed />

  <route-list-header
    tabs="{{tabs}}"
    activeTab="{{activeTab}}"
    categories="{{categories}}"
    activeCategory="{{activeCategory}}"
    filters="{{filterValues}}"
    navTop="{{navBarTotalHeight}}"
    bind:tabchange="handleTabChange"
    bind:categorychange="handleCategoryChange"
    bind:filtertap="handleFilterTap"
    bind:morefilter="handleMoreFilter"
    bind:searchtap="handleSearchTap"
  />

  <!-- 加载中（首次） -->
  <view class="loading-container" wx:if="{{loading && list.length === 0}}">
    <xj-loading text="加载中..." vertical />
  </view>

  <!-- 空状态 -->
  <xj-empty
    wx:elif="{{!loading && list.length === 0}}"
    type="search"
    description="暂无相关线路"
  />

  <!-- 线路列表 -->
  <view class="route-list" wx:else>
    <view
      class="route-card-wrap"
      wx:for="{{list}}"
      wx:key="id"
    >
      <!-- 路线卡片（新设计） -->
      <view class="list-route-card" data-id="{{item.id}}" bindtap="handleRouteTap">
        <!-- 图片区 -->
        <view class="list-route-card__image-wrap">
          <image
            class="list-route-card__image"
            src="{{item.coverImage || '/assets/images/placeholder/route.png'}}"
            mode="aspectFill"
            lazy-load
          />
          <!-- 位置标签 -->
          <view class="list-route-card__location-tag" wx:if="{{item.location}}">
            <image class="list-route-card__loc-icon" src="/assets/icons/common/location.png" mode="aspectFit" />
            <text class="list-route-card__loc-text">{{item.location}}</text>
          </view>
          <!-- 收藏按钮 -->
          <view class="list-route-card__favorite" catchtap="handleFavorite" data-id="{{item.id}}">
            <text class="list-route-card__fav-icon">{{item.isFavorite ? '♥' : '♡'}}</text>
          </view>
        </view>

        <!-- 内容区 -->
        <view class="list-route-card__content">
          <!-- 标签行 -->
          <view class="list-route-card__tags" wx:if="{{item.tags && item.tags.length}}">
            <text
              wx:for="{{item.tags}}"
              wx:for-item="tag"
              wx:for-index="tagIdx"
              wx:key="tagIdx"
              wx:if="{{tagIdx < 3}}"
              class="list-route-card__tag list-route-card__tag--{{tagIdx === 0 ? 'primary' : tagIdx === 1 ? 'orange' : tagIdx === 2 ? 'blue' : 'green'}}"
            >{{tag}}</text>
          </view>

          <!-- 标题 -->
          <text class="list-route-card__title">{{item.name}}</text>

          <!-- 评分和已售 -->
          <view class="list-route-card__meta">
            <text class="list-route-card__rating" wx:if="{{item.rating}}">⭐ {{item.rating}}</text>
            <view class="list-route-card__divider" wx:if="{{item.rating && item.salesCount}}"></view>
            <text class="list-route-card__sales" wx:if="{{item.salesCount}}">已售 {{item.salesCount}} 人</text>
          </view>

          <!-- 底部：日期 + 价格 + CTA -->
          <view class="list-route-card__bottom">
            <view class="list-route-card__bottom-left">
              <text class="list-route-card__depart" wx:if="{{item.nearestDate}}">最近出发 {{item.nearestDate}}</text>
              <view class="list-route-card__price-row">
                <text class="list-route-card__price-symbol">¥</text>
                <text class="list-route-card__price-value">{{item.minPrice || 0}}</text>
                <text class="list-route-card__price-unit">/人起</text>
              </view>
            </view>
            <view class="list-route-card__cta">
              <text class="list-route-card__cta-text">查看详情</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <xj-loading size="sm" text="加载中..." />
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
      <text>- 没有更多了 -</text>
    </view>
  </view>

  <!-- 筛选遮罩 -->
  <view
    class="filter-mask"
    wx:if="{{filterPanel.show}}"
    bindtap="handleFilterClose"
    style="top: {{filterPanelTop}}px;"
  />

  <!-- 筛选下拉面板 -->
  <view
    class="filter-panel"
    wx:if="{{filterPanel.show}}"
    style="top: {{filterPanelTop}}px;"
    catchtap
  >
    <text class="filter-panel__title">{{filterPanel.title}}</text>
    <view class="filter-panel__grid filter-panel__grid--{{filterPanel.type}}">
      <view
        class="filter-chip {{filterPanel.pendingValue === item.value ? 'filter-chip--active' : ''}}"
        wx:for="{{filterPanel.options}}"
        wx:key="value"
        wx:if="{{item.value !== ''}}"
        data-value="{{item.value}}"
        bindtap="handleFilterChipTap"
      >{{item.label}}</view>
    </view>
    <view class="filter-panel__footer">
      <view class="filter-panel__btn filter-panel__btn--reset" bindtap="handleFilterReset">重置</view>
      <view class="filter-panel__btn filter-panel__btn--confirm" bindtap="handleFilterConfirm">确定</view>
    </view>
  </view>

</view>
<xj-toast id="xj-toast"/>
