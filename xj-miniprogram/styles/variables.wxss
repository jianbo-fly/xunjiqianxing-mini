/**
 * CSS Variables - CSS变量
 *
 * 基于寻迹千行 UI 设计规范 v4.0
 * 品牌色：红橙 #EC3713（对齐 Figma 设计稿）
 */

page {
  /* ===== 颜色 - 品牌色 ===== */
  --color-primary: #EC3713;
  --color-primary-light: #FFF7ED;
  --color-primary-dark: #C52E0F;
  --color-primary-subtle: rgba(236, 55, 19, 0.08);
  --color-primary-bg: rgba(236, 55, 19, 0.05);    /* 极淡主色背景：选中态 */
  --color-primary-tint: rgba(236, 55, 19, 0.1);   /* 浅主色背景：徽章/加号按钮 */
  --color-primary-border: rgba(236, 55, 19, 0.3); /* 半透明主色：投影/边框 */
  --color-primary-gradient: linear-gradient(to right, #EC3713, #EA580C);
  --color-primary-ultralight: #FEECE9; /* 极浅主色背景：选中 chip、优惠券背景 */

  /* ===== 颜色 - 功能色 ===== */
  --color-success: #16A34A;
  --color-success-light: #F0FDF4;
  --color-success-gradient: linear-gradient(to right, #10B981, #059669);
  --color-warning: #F97316;          /* 橙色：待出发等中间状态 */
  --color-warning-light: #FFF7ED;
  --color-error: #E74C3C;
  --color-error-light: #FFF2F0;
  --color-danger: #E74C3C;
  --color-info: #2563EB;
  --color-info-light: #EFF6FF;
  --color-info-gradient: linear-gradient(to right, #3B82F6, #2563EB);
  --color-cancelled-gradient: linear-gradient(to right, #9CA3AF, #6B7280);
  --color-star: #F59E0B;             /* 星级评分 */
  --color-price: #EC3713;
  --color-wechat: #07C160;           /* 微信绿 */

  /* ===== 颜色 - 状态文字 ===== */
  --color-text-disabled: #C0C4CC;

  /* ===== 颜色 - 文字 ===== */
  --color-text-primary: #222222;     /* Airbnb 主文字色 */
  --color-text-strong: #1a1a1a;      /* 强调文字：套餐标题、计数器数字 */
  --color-text-body: #3d3d3d;        /* 正文文字：标签、列表项 */
  --color-text-secondary: #717171;   /* Airbnb 次要文字色 */
  --color-text-tertiary: #9CA3AF;
  --color-text-placeholder: #BBBBBB;
  --color-text-inverse: #FFFFFF;

  /* ===== 颜色 - 背景 ===== */
  --color-bg-page: #F7F7F7;          /* Airbnb 页面背景 */
  --color-bg-card: #FFFFFF;
  --color-bg-gray: #F7F7F7;
  --color-bg-mask: rgba(0,0,0,0.5);
  --color-bg-mask-light: rgba(0,0,0,0.3);
  --color-overlay-dark: rgba(0,0,0,0.45);  /* 图片深色遮罩 */
  --color-overlay-mid: rgba(0,0,0,0.6);    /* 图片评分底色 */
  --color-overlay-light: rgba(255,255,255,0.85); /* 图片浅色遮罩 */
  --color-bg-warm: linear-gradient(180deg, #FFF7ED 0%, #F7F7F7 100%);

  /* ===== 颜色 - 边框 ===== */
  --color-border: #DDDDDD;           /* Airbnb 边框色 */
  --color-border-medium: #C8C8C8;    /* 中灰边框：减号按钮、分隔 */
  --color-border-light: #EBEBEB;     /* Airbnb 分隔线色 */
  --color-divider: #EBEBEB;

  /* ===== 颜色 - 消息模块暖棕色系 ===== */
  --color-warm-text: #5C4D4A;        /* 消息主文字 */
  --color-warm-text-deep: #1F1412;   /* 消息加粗文字 */
  --color-warm-text-muted: #A89C9A;  /* 消息次要文字 */
  --color-warm-border: #E6E0DF;      /* 消息分隔线 */
  --color-warm-bg: rgba(248,246,246,0.95); /* 消息顶栏背景 */

  /* ===== 颜色 - 标签系统 ===== */
  --tag-orange-bg: #FFF7ED;
  --tag-orange-text: #EA580C;
  --tag-gray-bg: #F3F4F6;
  --tag-gray-text: #4B5563;
  --tag-blue-bg: #EFF6FF;
  --tag-blue-text: #2563EB;
  --tag-green-bg: #F0FDF4;
  --tag-green-text: #16A34A;
  --tag-purple-bg: #FAF5FF;
  --tag-purple-text: #9333EA;

  /* ===== 字体 - 字号 ===== */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 44rpx;
  --font-size-price: 40rpx;

  /* ===== 字体 - 字重 ===== */
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* ===== 字体 - 行高 ===== */
  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-loose: 1.8;

  /* ===== 间距 ===== */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;

  /* ===== 间距 - 页面 ===== */
  --page-padding: 40rpx;             /* Airbnb 页面左右边距更宽 */
  --card-padding: 32rpx;             /* Airbnb 卡片内边距 */
  --section-gap: 32rpx;

  /* ===== 圆角 =====
   * 语义化收敛：硬编码 8/12/16/24/32/48rpx 请一律使用下面的 token。
   * 旧值 xs/sm 微调 +2rpx（6→8、10→12），视觉差异不可感知。
   */
  --radius-none: 0;
  --radius-xs: 8rpx;                 /* 小标签、小徽章 */
  --radius-sm: 12rpx;                /* chip、小药丸 */
  --radius-btn: 16rpx;               /* 按钮、输入框、小卡片 */
  --radius-md: 24rpx;                /* 卡片 */
  --radius-lg: 32rpx;                /* 大卡片、弹窗 */
  --radius-xl: 48rpx;                /* hero 元素 */
  --radius-pill: 40rpx;              /* 胶囊搜索/按钮 */
  --radius-full: 9999rpx;

  /* ===== 阴影（Airbnb 三层柔和阴影） =====
   * 4 档基础：sm / md / lg / xl
   * 特殊场景：card、card-hover、primary-sm、primary-lg、hero、inset-top、inset-bottom
   */
  --shadow-none: none;
  --shadow-sm: 0 0 0 1rpx rgba(0,0,0,0.04), 0 2rpx 6rpx rgba(0,0,0,0.04);
  --shadow-md: 0 0 0 1rpx rgba(0,0,0,0.04), 0 4rpx 12rpx rgba(0,0,0,0.06), 0 8rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 0 0 1rpx rgba(0,0,0,0.04), 0 8rpx 24rpx rgba(0,0,0,0.08), 0 16rpx 32rpx rgba(0,0,0,0.08);
  --shadow-xl: 0 0 0 1rpx rgba(0,0,0,0.04), 0 16rpx 40rpx rgba(0,0,0,0.12), 0 24rpx 48rpx rgba(0,0,0,0.10);
  --shadow-card: 0 0 0 1rpx rgba(0,0,0,0.04), 0 4rpx 12rpx rgba(0,0,0,0.05), 0 8rpx 16rpx rgba(0,0,0,0.04);
  --shadow-card-hover: 0 0 0 1rpx rgba(0,0,0,0.06), 0 8rpx 24rpx rgba(0,0,0,0.10), 0 16rpx 32rpx rgba(0,0,0,0.08);
  --shadow-primary-sm: 0 6rpx 16rpx rgba(236, 55, 19, 0.25);
  --shadow-primary-md: 0 8rpx 20rpx rgba(236, 55, 19, 0.3);
  --shadow-primary-lg: 0 20rpx 30rpx -6rpx rgba(236, 55, 19, 0.3), 0 8rpx 12rpx -8rpx rgba(236, 55, 19, 0.3);
  --shadow-hero: 0 8rpx 32rpx rgba(0, 0, 0, 0.14);
  --shadow-inset-top: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  --shadow-inset-bottom: 0 -8rpx 24rpx -4rpx rgba(0, 0, 0, 0.08);

  /* ===== 动画 ===== */
  --duration-fast: 150ms;
  --duration-normal: 300ms;
  --duration-slow: 500ms;

  /* ===== 层级 ===== */
  --z-index-default: 1;
  --z-index-dropdown: 100;
  --z-index-sticky: 200;
  --z-index-fixed: 300;
  --z-index-modal-backdrop: 400;
  --z-index-modal: 500;
  --z-index-popover: 600;
  --z-index-tooltip: 700;
  --z-index-toast: 800;

  /* ===== 组件尺寸 - 按钮 ===== */
  --button-height-sm: 56rpx;
  --button-height-md: 72rpx;
  --button-height-lg: 88rpx;

  /* ===== 组件尺寸 - 输入框 ===== */
  --input-height: 88rpx;

  /* ===== 组件尺寸 - 头像 ===== */
  --avatar-size-sm: 48rpx;
  --avatar-size-md: 64rpx;
  --avatar-size-lg: 96rpx;
  --avatar-size-xl: 128rpx;

  /* ===== 组件尺寸 - 图标 ===== */
  --icon-size-sm: 32rpx;
  --icon-size-md: 40rpx;
  --icon-size-lg: 48rpx;

  /* ===== 组件尺寸 - 导航 ===== */
  --nav-bar-height: 88rpx;
  --tab-bar-height: 100rpx;
}
