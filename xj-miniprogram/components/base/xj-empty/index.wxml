<view class="xj-empty {{cardMode ? 'xj-empty--card' : ''}} {{customClass}}">
  <!-- 插图 -->
  <image class="xj-empty__image" src="{{emptyImage}}" mode="aspectFit" />

  <!-- 标题 -->
  <text class="xj-empty__title">{{emptyText}}</text>

  <!-- 副标题 -->
  <text class="xj-empty__subtitle" wx:if="{{subtitle}}">{{subtitle}}</text>

  <!-- 操作按钮 -->
  <view class="xj-empty__action" wx:if="{{buttonText}}">
    <view class="xj-empty__btn" bindtap="handleAction">{{buttonText}}</view>
  </view>

  <!-- 自定义内容插槽 -->
  <view class="xj-empty__slot">
    <slot></slot>
  </view>
</view>
