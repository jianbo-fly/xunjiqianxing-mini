.xj-toast-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 160rpx;
  display: flex;
  justify-content: center;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transform: translateY(16rpx);
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.xj-toast-container--visible {
  opacity: 1;
  transform: translateY(0);
}

.xj-toast {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 76%;
  padding: 20rpx 44rpx;
  border-radius: 100rpx;
  background: rgba(28, 28, 30, 0.88);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
}

.xj-toast--success {
  background: rgba(22, 163, 74, 0.94);
}

.xj-toast--error {
  background: rgba(220, 38, 38, 0.94);
}

.xj-toast--warning {
  background: rgba(217, 119, 6, 0.94);
}

.xj-toast-icon {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.xj-toast-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.45;
  text-align: center;
}
