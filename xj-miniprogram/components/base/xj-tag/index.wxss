.xj-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
  border-radius: var(--radius-xs);
  white-space: nowrap;
}

/* 尺寸 */
.xj-tag--sm {
  padding: 2rpx 8rpx;
  font-size: 18rpx;
}

.xj-tag--md {
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
}

/* 类型 */
.xj-tag--default {
  background: var(--color-bg-gray);
  color: var(--color-text-secondary);
}

.xj-tag--primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.xj-tag--success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.xj-tag--warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.xj-tag--error {
  background: var(--color-error-light);
  color: var(--color-error);
}

/* 颜色变体 - Orange */
.xj-tag--orange {
  background: var(--tag-orange-bg, #FFF7ED);
  color: var(--tag-orange-text, #EA580C);
}

/* 颜色变体 - Blue */
.xj-tag--blue {
  background: var(--tag-blue-bg, #EFF6FF);
  color: var(--tag-blue-text, #2563EB);
}

/* 颜色变体 - Green */
.xj-tag--green {
  background: var(--tag-green-bg, #F0FDF4);
  color: var(--tag-green-text, #16A34A);
}

/* 颜色变体 - Purple */
.xj-tag--purple {
  background: var(--tag-purple-bg, #FAF5FF);
  color: var(--tag-purple-text, #9333EA);
}

/* 颜色变体 - Gray */
.xj-tag--gray {
  background: var(--tag-gray-bg, #F3F4F6);
  color: var(--tag-gray-text, #4B5563);
}

/* 镂空 */
.xj-tag--plain {
  background: transparent;
  border: 2rpx solid currentColor;
}

/* 圆角 */
.xj-tag--round {
  border-radius: var(--radius-full);
}

/* 关闭按钮 */
.xj-tag__close {
  margin-left: 8rpx;
  font-size: 20rpx;
  line-height: 1;
}
